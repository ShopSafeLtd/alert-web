ExclusionForm.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/global/ImageMenuItem/ImageMenuItem.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/global/SpeedDial/index.js",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/global/SpeedDial/SpeedDial/SpeedDial.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/graphql-src/offenders/queries/index.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/graphql-src/offenders/queries/offenders.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/graphql-src/address/queries/index.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/graphql-src/address/queries/previous-addresses.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/graphql-src/address/fragments/basic-location.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/graphql-src/offenders/queries/offender-feed.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/graphql-src/users/fragments/index.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/graphql-src/bans/fragments/index.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/graphql-src/groups/fragments/index.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/graphql-src/bans/fragments/ban.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/graphql-src/groups/fragments/basic-group.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/graphql-src/tags/queries/index.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/graphql-src/tags/queries/tags.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/incidents/edit/EditIncident/EditIncident.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/incidents/edit/desktop/EditDesktop/EditDesktop.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/incidents/edit/desktop/ExistingOffenderPopOver/ExistingOffenderPopOver.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/incidents/edit/desktop/EditLocation/EditLocation.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/incidents/edit/desktop/NewOffenderPopOver/NewOffenderPopOver.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/incidents/edit/desktop/EditOffenders/EditOffenders.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/incidents/edit/desktop/EditDescription/EditDescription.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/incidents/edit/desktop/EditOffenderPopOver/EditOffenderPopOver.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/incidents/edit/desktop/AssignOffendersPopOver/AssignOffendersPopOver.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/global/edit/AddGroups/AddGroups.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/global/edit/EditImages/EditImages.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/global/edit/EditGroups/EditGroups.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/incidents/edit/desktop/AddNewOffender/AddNewOffender.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/incidents/edit/desktop/AddExistingOffenders/AddExistingOffenders.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/incidents/edit/desktop/OffenderStack/OffenderStack.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/incidents/edit/desktop/Grow/Grow.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/incidents/edit/desktop/OffenderStacked/OffenderStacked.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/images/Images.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/incidents/edit/desktop/SearchOffenders/SearchOffenders.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/incidents/edit/desktop/OffenderList/OffenderList.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/global/skeletons/OffenderPreviewSkeleton/OffenderPreviewSkeleton.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/graphql-src/incidents/queries/edit-incident.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/graphql-src/incidents/mutations/update-incident.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/graphql-src/images/mutations/index.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/graphql-src/images/mutations/upload-image.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/images/Offender.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/views/app-views/offenders/router.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/views/app-views/scheme/router.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/views/app-views/incidents/router.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/views/app-views/user/router.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/offenders/feed/OffenderFeedQuery/OffenderFeedQuery.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/offenders/feed/OffenderFeed/OffenderFeed.jsx",["3518","3519"],"import React, { Fragment } from 'react';\nimport styled from 'styled-components';\nimport Button from '@material-ui/core/Button';\nimport { Link } from 'react-router-dom';\nimport IconButton from '@material-ui/core/IconButton';\nimport FilterIcon from '@material-ui/icons/FilterList';\n\nimport OffenderCard from '../OffenderCard/OffenderCard';\nimport {\n  FeedContainer,\n  FeedCardContainer,\n  SkeletonContainer\n} from '../../../global/feed';\nimport { PullToRefresh } from '../../../global/pullToRefresh';\nimport { Card } from '../../../global/cards';\nimport { EmptyState } from '../../../global/emptyStates';\nimport DeleteOffenderModal from '../DeleteOffenderModal/DeleteOffenderModal';\nimport AddExclusionPopOver from '../../global/AddExclusionPopOver/AddExclusionPopOver';\nimport ViewExclusionPopOver from '../../global/ViewExclusionPopOver/ViewExclusionPopOver';\nimport ViewIncidentPopOver from '../ViewIncidentPopOver/ViewIncidentPopOver';\nimport UnapprovedCardGroups from '../../../global/cards/UnapprovedCardGroups/UnapprovedCardGroups';\nimport OffenderFilter from '../OffenderFilter/OffenderFilter';\nimport ViewOffenderPopOver from '../ViewOffenderPopOver/ViewOffenderPopOver';\nimport LabelModal from '../LabelModal/LabelModal';\nimport ActiveOffenderModal from '../ActiveOffenderModal/ActiveOffenderModal';\nimport InactiveOffenderModal from '../InactiveOffenderModal/InactiveOffenderModal';\nimport OffenderSkeletonCard from '../OffenderSkeletonCard/OffenderSkeletonCard';\nimport DeclineDialog from '../DeclineDialog/DeclineDialog';\nimport Offenders from '../../../../images/Offenders';\n\nconst EmptyContainer = styled.div`\n  height: calc(100vh - 167px);\n  display: flex;\n  align-items: center;\n`;\n\nclass OffenderFeed extends React.Component {\n  constructor(props) {\n    super(props);\n    this.state = {\n      deleteOffenderModal: false,\n      deleteOffenderId: '',\n      declineOffenderDialog: false,\n      declineOffenderId: '',\n      disabled: false,\n      addExclusionPopOver: false,\n      addExclusionId: '',\n      viewExclusionPopOver: false,\n      viewExclusionId: '',\n      viewExclusionOffender: '',\n      viewIncidentPopOver: false,\n      viewIncidentId: '',\n      approve: false,\n      approveId: '',\n      approveGroups: [],\n      pristine: true,\n      viewOffenderPopOver: false,\n      viewOffender: {\n        images: [],\n        age: 'UNKNOWN',\n        build: 'UNKNOWN',\n        race: 'UNKNOWN',\n        gender: 'UNKNOWN',\n        exclusions: [],\n        incidents: []\n      },\n      viewLabel: false,\n      label: {\n        name: '',\n        helpText: ''\n      },\n      activeOffenderModal: false,\n      activeOffenderId: '',\n      inactiveOffenderModal: false,\n      inactiveOffenderId: '',\n      filterOpen: false\n    };\n  }\n\n  componentDidUpdate() {\n    this.props.offenders !== undefined &&\n      this.props.offenders.length > 0 &&\n      this.state.pristine &&\n      this.setState({\n        pristine: false\n      });\n  }\n\n  setExcluded = value => {\n    this.setState({\n      excluded: value\n    });\n  };\n\n  toggleDeleteOffenderModal = id =>\n    this.setState({\n      deleteOffenderModal: !this.state.deleteOffenderModal,\n      deleteOffenderId: id || ''\n    });\n\n  toggleDeclineOffender = id =>\n    this.setState({\n      declineOffenderDialog: !this.state.declineOffenderDialog,\n      declineOffenderId: id || ''\n    });\n\n  toggleAddExclusionPopOver = id =>\n    this.setState({\n      addExclusionPopOver: !this.state.addExclusionPopOver,\n      addExclusionId: id || ''\n    });\n\n  toggleViewExclusionPopOver = (exclusion, offender) =>\n    this.setState({\n      viewExclusionPopOver: !this.state.viewExclusionPopOver,\n      viewExclusionId: exclusion || '',\n      viewExclusionOffender: offender || ''\n    });\n\n  toggleIncidentPopOver = incident => {\n    if (incident !== undefined) {\n      this.setState({\n        viewIncidentPopOver: !this.state.viewIncidentPopOver,\n        viewIncidentId: incident\n      });\n    } else {\n      this.setState({\n        viewIncidentPopOver: !this.state.viewIncidentPopOver,\n        viewIncidentId: ''\n      });\n    }\n  };\n\n  toggleApprove = (id, offenders) =>\n    this.setState({\n      approve: !this.state.approve,\n      approveId: id || '',\n      approveGroups: [],\n      approveOffenders: offenders\n    });\n\n  toggleApproveGroups = id => {\n    const { approveGroups } = this.state;\n    if (approveGroups.indexOf(id) === -1) {\n      this.setState({\n        approveGroups: [...approveGroups, id]\n      });\n    } else {\n      let newSelected = approveGroups.filter(item => {\n        return item !== id;\n      });\n      this.setState({\n        approveGroups: newSelected\n      });\n    }\n  };\n\n  toggleViewOffenderPopOver = offender =>\n    this.setState({\n      viewOffenderPopOver: !this.state.viewOffenderPopOver,\n      viewOffender:\n        offender !== undefined\n          ? offender\n          : {\n              images: [],\n              age: 'UNKNOWN',\n              build: 'UNKNOWN',\n              race: 'UNKNOWN',\n              gender: 'UNKNOWN',\n              exclusions: [],\n              incidents: []\n            }\n    });\n\n  toggleViewLabel = label =>\n    this.setState({\n      viewLabel: !this.state.viewLabel,\n      label:\n        label !== undefined\n          ? label\n          : {\n              name: '',\n              helpText: ''\n            }\n    });\n\n  toggleActiveOffender = offender => {\n    this.setState({\n      activeOffenderModal: !this.state.activeOffenderModal,\n      activeOffenderId: offender !== undefined ? offender : ''\n    });\n  };\n\n  toggleInactiveOffender = offender => {\n    this.setState({\n      inactiveOffenderModal: !this.state.inactiveOffenderModal,\n      inactiveOffenderId: offender !== undefined ? offender : ''\n    });\n  };\n\n  render() {\n    const {\n      setStatusBar,\n      userId,\n      deleteOffender,\n      loading,\n      offenders,\n      approveOffender,\n      loadMore,\n      filter,\n      setFilter,\n      order,\n      setOrder,\n      search,\n      admin,\n      markOffenderActive,\n      loadingMore,\n      networkError,\n      retryLoad,\n      refetch,\n      filterPristine,\n      role\n    } = this.props;\n    const {\n      deleteOffenderModal,\n      deleteOffenderId,\n      declineOffenderDialog,\n      declineOffenderId,\n      addExclusionPopOver,\n      addExclusionId,\n      viewExclusionPopOver,\n      viewExclusionId,\n      viewExclusionOffender,\n      viewIncidentPopOver,\n      viewIncidentId,\n      approve,\n      approveId,\n      approveGroups,\n      viewOffenderPopOver,\n      viewOffender,\n      viewLabel,\n      label,\n      disabled,\n      activeOffenderModal,\n      activeOffenderId,\n      inactiveOffenderModal,\n      inactiveOffenderId,\n      pristine,\n      filterOpen\n    } = this.state;\n\n    const handleDelete = async () => {\n      setStatusBar(true, 'Deleting Offender...');\n      this.setState({\n        disabled: true\n      });\n      await deleteOffender({\n        variables: {\n          id: deleteOffenderId\n        },\n        optimisticResponse: {\n          deleteOffender: {\n            id: deleteOffenderId,\n            optimistic: true,\n            __typename: 'Offender'\n          }\n        }\n      });\n      this.setState({\n        disabled: false\n      });\n      setStatusBar(false, '');\n    };\n\n    const handleApprove = async groups => {\n      setStatusBar(true, 'Approving Offender...');\n      const add = groups\n        .filter(\n          id =>\n            !offenders\n              .find(({ id }) => id === approveId)\n              .groups.map(({ id }) => id)\n              .includes(id)\n        )\n        .map(id => ({ id }));\n      const remove = offenders\n        .find(({ id }) => id === approveId)\n        .groups.map(({ id }) => id)\n        .filter(id => !groups.includes(id))\n        .map(id => ({ id }));\n\n      await approveOffender({\n        variables: {\n          id: approveId,\n          groups: add.length > 0 ? add : undefined,\n          removeGroups: remove.length > 0 ? remove : undefined\n        }\n      });\n      setStatusBar(false, '');\n      this.setState({ approve: false, approveId: '' });\n    };\n\n    const handleDecline = async () => {\n      setStatusBar(true, 'Deleting Offender...');\n      this.setState({\n        disabled: true\n      });\n      await deleteOffender({\n        variables: {\n          id: declineOffenderId\n        },\n        optimisticResponse: {\n          deleteOffender: {\n            id: declineOffenderId,\n            optimistic: true,\n            __typename: 'Offender'\n          }\n        }\n      });\n      this.toggleDeclineOffender();\n      this.setState({\n        disabled: false\n      });\n      setStatusBar(false, '');\n    };\n\n    return loading && pristine ? (\n      <FeedContainer to=\"/offenders/add\" text=\"Offender\">\n        <PullToRefresh onRefresh={refetch}>\n          <FeedCardContainer>\n            <SkeletonContainer cardHeight=\"500px\">\n              <OffenderSkeletonCard />\n            </SkeletonContainer>\n          </FeedCardContainer>\n          <OffenderFilter\n            open={filterOpen}\n            handleClose={() => this.setState({ filterOpen: false })}\n            order={order}\n            setOrder={setOrder}\n            filter={filter}\n            setFilter={setFilter}\n          />\n        </PullToRefresh>\n      </FeedContainer>\n    ) : !!offenders && offenders.length > 0 ? (\n      <Fragment>\n        <FeedContainer\n          to=\"/offenders/add\"\n          loadMore={loadMore}\n          text=\"Offender\"\n          loading={loadingMore}\n          networkError={networkError}\n          retryLoad={retryLoad}\n        >\n          <PullToRefresh onRefresh={refetch}>\n            <FeedCardContainer>\n              {offenders.map(offender => (\n                <Card key={offender.id} height=\"500px\">\n                  <OffenderCard\n                    key={offender.id}\n                    offender={offender}\n                    toggleDeleteOffenderModal={this.toggleDeleteOffenderModal}\n                    toggleDecline={this.toggleDeclineOffender}\n                    toggleDeleteExclusionModal={this.toggleDeleteExclusionModal}\n                    toggleAddExclusionPopOver={this.toggleAddExclusionPopOver}\n                    toggleViewExclusionPopOver={this.toggleViewExclusionPopOver}\n                    toggleIncidentPopOver={this.toggleIncidentPopOver}\n                    toggleApprove={this.toggleApprove}\n                    toggleViewOffenderPopOver={this.toggleViewOffenderPopOver}\n                    toggleViewLabel={this.toggleViewLabel}\n                    toggleActiveOffender={this.toggleActiveOffender}\n                    toggleInactiveOffender={this.toggleInactiveOffender}\n                    admin={admin}\n                  />\n                </Card>\n              ))}\n            </FeedCardContainer>\n          </PullToRefresh>\n        </FeedContainer>\n        <DeleteOffenderModal\n          visible={deleteOffenderModal}\n          close={this.toggleDeleteOffenderModal}\n          handleDelete={handleDelete}\n          disabled={disabled}\n        />\n        <DeclineDialog\n          open={declineOffenderDialog}\n          close={this.toggleDeclineOffender}\n          handleDecline={handleDecline}\n        />\n        <AddExclusionPopOver\n          visible={addExclusionPopOver}\n          close={this.toggleAddExclusionPopOver}\n          offenderId={addExclusionId}\n          filter={filter}\n          admin={admin}\n          search={search}\n          userId={userId}\n          role={role}\n        />\n        <ViewExclusionPopOver\n          visible={viewExclusionPopOver}\n          close={this.toggleViewExclusionPopOver}\n          exclusionId={viewExclusionId}\n          offenderId={viewExclusionOffender}\n          filter={filter}\n          admin={admin}\n          search={search}\n          userId={userId}\n        />\n        <ViewIncidentPopOver\n          visible={viewIncidentPopOver}\n          close={this.toggleIncidentPopOver}\n          incidentId={viewIncidentId}\n        />\n        <UnapprovedCardGroups\n          visible={approve}\n          cancel={this.toggleApprove}\n          toggle={this.toggleApproveGroups}\n          selected={approveGroups}\n          approve={handleApprove}\n          offender={offenders.find(({ id }) => id === approveId)}\n        />\n        <ViewOffenderPopOver\n          visible={viewOffenderPopOver}\n          close={this.toggleViewOffenderPopOver}\n          offender={viewOffender}\n          admin={admin}\n        />\n        <LabelModal\n          visible={viewLabel}\n          close={this.toggleViewLabel}\n          label={label}\n        />\n        <ActiveOffenderModal\n          open={activeOffenderModal}\n          close={this.toggleActiveOffender}\n          offenderId={activeOffenderId}\n          markOffenderActive={markOffenderActive}\n        />\n        <InactiveOffenderModal\n          open={inactiveOffenderModal}\n          close={this.toggleInactiveOffender}\n          offenderId={inactiveOffenderId}\n          markOffenderActive={markOffenderActive}\n        />\n        <OffenderFilter\n          open={filterOpen}\n          handleClose={() => this.setState({ filterOpen: false })}\n          order={order}\n          setOrder={setOrder}\n          filter={filter}\n          setFilter={setFilter}\n        />\n      </Fragment>\n    ) : filterPristine ? (\n      <FeedContainer to=\"/offenders/add\" text=\"Offender\">\n        <PullToRefresh onRefresh={refetch}>\n          <EmptyContainer>\n            <EmptyState\n              image={<Offenders height=\"96px\" width=\"96px\" />}\n              text=\"There are currently no active offenders.\"\n              actions={[\n                <Button\n                  variant=\"contained\"\n                  color=\"primary\"\n                  component={Link}\n                  to=\"/offenders/add\"\n                >\n                  Add First Offender\n                </Button>\n              ]}\n            />\n          </EmptyContainer>\n          <OffenderFilter\n            open={filterOpen}\n            handleClose={() => this.setState({ filterOpen: false })}\n            order={order}\n            setOrder={setOrder}\n            filter={filter}\n            setFilter={setFilter}\n          />\n        </PullToRefresh>\n      </FeedContainer>\n    ) : (\n      <FeedContainer to=\"/offenders/add\" text=\"Offender\">\n        <PullToRefresh onRefresh={refetch}>\n          <EmptyContainer>\n            <EmptyState\n              image={<Offenders height=\"96px\" width=\"96px\" />}\n              text=\"We could not find any offenders that match.\"\n              actions={[\n                <Button\n                  variant=\"contained\"\n                  color=\"primary\"\n                  onClick={() => this.setState({ filterOpen: true })}\n                >\n                  Change Filter\n                </Button>\n              ]}\n            />\n          </EmptyContainer>\n          <OffenderFilter\n            open={filterOpen}\n            handleClose={() => this.setState({ filterOpen: false })}\n            order={order}\n            setOrder={setOrder}\n            filter={filter}\n            setFilter={setFilter}\n          />\n        </PullToRefresh>\n      </FeedContainer>\n    );\n  }\n\n  componentWillUnmount() {\n    this.props.toggleFetchOffenders(true);\n    !!this.props.setActions && this.props.setActions([]);\n  }\n}\n\nexport default OffenderFeed;\n","/Users/willgarrod/Projects/alert-web-2.0/src/old-components/offenders/feed/OffenderCard/OffenderCard.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/offenders/feed/OffenderFilter/OffenderFilter.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/offenders/feed/ViewOffenderPopOver/ViewOffenderPopOver.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/offenders/feed/ViewIncidentPopOver/ViewIncidentPopOver.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/offenders/feed/DeleteOffenderModal/DeleteOffenderModal.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/offenders/feed/ActiveOffenderModal/ActiveOffenderModal.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/offenders/feed/OffenderSkeletonCard/OffenderSkeletonCard.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/offenders/feed/LabelModal/LabelModal.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/offenders/feed/DeclineDialog/DeclineDialog.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/offenders/feed/InactiveOffenderModal/InactiveOffend