ame: string;\n    password: string;\n  };\n  services: {\n    hytalkRY: boolean;\n    hytalk3000: boolean;\n    dem: boolean;\n  };\n  devices: {\n    serialNumber: string;\n    model: string;\n  }[];\n  hytalk: {\n    callSign: string;\n    type: string;\n    talkGroups: {\n      name: string;\n    }[];\n  };\n  dem: {\n    group: {\n      name: string;\n    }|null;\n  }\n}\n\nexport type SubmitDetailsArg = UserData['details']\nexport type SubmitServicesArg = UserData['services']\nexport type SubmitHyTalk = UserData['hytalk']\nexport interface SubmitHyTalkArg extends SubmitHyTalk {\n  devices: UserData['devices']\n}\nexport type SubmitDem = UserData['dem']\nexport interface SubmitDemArg extends SubmitDem {\n  devices: UserData['devices']\n}\n\ninterface Props {\n  onClose(): void;\n  update?: MutationUpdaterFn<CreateDevicesRes>;\n  onSuccess?(): void;\n  onError?(): void;\n  companyId: string;\n}\n\nconst initialValues: UserData = {\n  details: {\n    name: '',\n    userName: '',\n    password: '',\n  },\n  services: {\n    hytalkRY: false,\n    hytalk3000: false,\n    dem: false\n  },\n  hytalk: {\n    callSign: '',\n    talkGroups: [],\n    type: 'USER'\n  },\n  devices: [],\n  dem: {\n    group: null\n  }\n}\n\nexport const AddDeviceUserForm = ({\n  onClose,\n  update,\n  onError,\n  onSuccess,\n  companyId\n}: Props) => {\n  const [data, setData] = useState<UserData>(initialValues)\n  const [step, setStep] = useState(0)\n\n  const handleClose = () => {\n    setStep(0)\n    setData(initialValues)\n    onClose();\n  };\n\n  const handleSubmit = async () => {\n    handleClose()\n  };\n\n  const submitDetails = (details: SubmitDetailsArg) => {\n    setData({\n      ...data,\n      details\n    })\n    setStep(step + 1)\n  }\n\n  const submitServices = (services: SubmitServicesArg) => {\n    setData({\n      ...data,\n      services\n    })\n    setStep(step + 1)\n  }\n\n  const submitHyTalk = (hytalk: SubmitHyTalkArg) => {\n    setData({\n      ...data,\n      hytalk: {\n        callSign: hytalk.callSign,\n        talkGroups: hytalk.talkGroups,\n        type: hytalk.type\n      },\n      devices: hytalk.devices\n    })\n    setStep(step + 1)\n  }\n \n  const submitDem = (dem: SubmitDemArg) => {\n    setData({\n      ...data,\n      dem: {\n        group: dem.group\n      },\n       devices: dem.devices\n    })\n    setStep(step + 1)\n  }\n\n  return (\n    <>\n      <Steps progressDot current={step} style={{ marginBottom: 10 }}>\n        <Step title=\"Details\" />\n        <Step title=\"Services\" />\n        {(data.services.hytalkRY || data.services.hytalk3000) && <Step title=\"HyTalk\" />}\n        {data.services.dem && <Step title=\"Evidence Management\" />}\n        <Step title=\"Confirm\" />\n      </Steps>\n      {step === 0 && <DetailsForm\n        onClose={handleClose}\n        onSubmit={submitDetails}\n      />}\n      {step === 1 && <ServicesForm\n        onBack={() => setStep(step - 1)}\n        onSubmit={submitServices}\n      />}\n      {step === 2 && <HytalkForm \n        onBack={() => setStep(step - 1)}\n        onSubmit={submitHyTalk}\n      />}\n      {step === 3 && <DemForm\n        onBack={() => setStep(step - 1)}\n        onSubmit={submitDem}\n        data={data}\n      />}\n      {step === 4 && <Confirm\n        onBack={() => setStep(step - 1)}\n        onSubmit={handleSubmit}\n        data={data}\n      />}\n    </>\n  );\n};\n","/Users/willgarrod/Projects/gotalk-manage/src/components/form-components/device-user/add/forms/index.ts",[],"/Users/willgarrod/Projects/gotalk-manage/src/components/form-components/device-user/add/forms/dem-form.tsx",[],"/Users/willgarrod/Projects/gotalk-manage/src/components/form-components/device-user/add/forms/confirm.tsx",[],"/Users/willgarrod/Projects/gotalk-manage/src/components/form-components/device-user/add/forms/services-form.tsx",[],"/Users/willgarrod/Projects/gotalk-manage/src/components/form-components/device-user/add/forms/hytalk-form.tsx",[],"/Users/willgarrod/Projects/gotalk-manage/src/components/form-components/device-user/add/forms/details-form.tsx",[],"/Users/willgarrod/Projects/gotalk-manage/src/graphql-src/companies/queries/company.ts",[],"/Users/willgarrod/Projects/gotalk-manage/src/views/app-views/admin-views/companies/company/views/sim-cards.tsx",[],"/Users/willgarrod/Projects/gotalk-manage/src/views/app-views/admin-views/companies/company/views/profile.tsx",[],"/Users/willgarrod/Projects/gotalk-manage/src/views/app-views/admin-views/companies/company/views/services.tsx",[],"/Users/willgarrod/Projects/gotalk-manage/src/views/app-views/admin-views/companies/company/views/portal-users/portal-users.tsx",[],"/Users/willgarrod/Projects/gotalk-manage/src/views/app-views/admin-views/companies/company/views/hytalk/radio-groups.tsx",[],"/Users/willgarrod/Projects/gotalk-manage/src/views/app-views/admin-views/companies/company/views/devices/device.tsx",["2908","2909","2910","2911","2912","2913","2914","2915","2916","2917","2918","2919","2920","2921","2922","2923","2924","2925","2926","2927","2928","2929"],"import React, { useState } from \"react\";\nimport { Table, Typography, Row, Button, Col, Modal } from \"antd\";\nimport { Link } from 'react-router-dom'\nimport { FontAwesomeIcon } from '@fortawesome/react-fontawesome'\nimport { faPlus, faTrash } from '@fortawesome/free-solid-svg-icons'\nimport { useQuery, useMutation } from '@apollo/client'\n\nimport { AddDeviceDrawer } from 'components/form-components/device'\nimport { DevicesArgs, DevicesRes, Devices as DevicesQuery } from 'graphql-src/devices/queries'\nimport { DeleteDevices, DeleteDevicesArgs, DeleteDevicesRes } from 'graphql-src/devices/mutations'\n\nconst { Text, Title } = Typography\nconst { confirm } = Modal;\n\ninterface Props {\n  match: any\n}\n\nconst Device = ({  }: Props) => {\n\n  return (\n    <div>\n\n    </div>\n  );\n};\n\nexport default Device;\n","/Users/willgarrod/Projects/gotalk-manage/src/views/app-views/admin-views/companies/company/views/dem/officers.tsx",[],"/Users/willgarrod/Projects/gotalk-manage/src/views/app-views/admin-views/companies/company/views/hytalk/radio-users.tsx",[],"/Users/willgarrod/Projects/gotalk-manage/src/views/app-views/admin-views/companies/company/views/billing.tsx",[],"/Users/willgarrod/Projects/gotalk-manage/src/views/app-views/admin-views/companies/company/views/dem/settings.tsx",[],"/Users/willgarrod/Projects/gotalk-manage/src/views/app-views/admin-views/companies/company/views/dem/device-stations.tsx",[],"/Users/willgarrod/Projects/gotalk-manage/src/views/app-views/admin-views/companies/company/views/users/users.tsx",["2930"],"import React, { useState } from \"react\";\nimport { Table, Typography, Tag, Row, Button, Col } from \"antd\";\nimport { Link } from \"react-router-dom\";\nimport { FontAwesomeIcon } from \"@fortawesome/react-fontawesome\";\nimport { faPlus } from \"@fortawesome/free-solid-svg-icons\";\nimport { AddDeviceUserDrawer } from \"components/form-components/device-user/add/add-device-user-drawer\";\nimport { useQuery } from \"@apollo/client\";\n\nimport {\n  DeviceUsers,\n  DeviceUsersArgs,\n  DeviceUsersRes,\n} from \"graphql-src/device-users/queries\";\nimport { useCompany } from '../../company-context'\n\nconst { Text, Title } = Typography;\n\ninterface TableData {\n  name: {\n    id: string;\n    name: string;\n  };\n  status: string;\n  services: string[];\n}\n\ninterface Props {\n  match: any;\n}\n\nconst Users = ({ match }: Props) => {\n  const [createUser, setCreateUser] = useState(false);\n  const [selected, setSelected] = useState<TableData[]>([]);\n\n  const { state } = useCompany()\n\n  const { data, loading } = useQuery<DeviceUsersRes, DeviceUsersArgs>(\n    DeviceUsers,\n    {\n      variables: {\n        company: state.id,\n      },\n    }\n  );\n\n  const columns = [\n    {\n      title: \"Name\",\n      dataIndex: \"name\",\n      key: \"name\",\n      render: (values: { name: string; id: string }) => (\n        <Link to={`${match.url}/${values.id}`}>{values.name}</Link>\n      ),\n    },\n    {\n      title: \"Status\",\n      dataIndex: \"status\",\n      key: \"status\",\n      render: (status: string) => {\n        return (\n          <Text type={status === \"Active\" ? \"success\" : \"danger\"} key={status}>\n            {status}\n          </Text>\n        );\n      },\n    },\n    {\n      title: \"Services\",\n      dataIndex: \"services\",\n      key: \"services\",\n      render: (services: any) => (\n        <span>\n          {services.map((tag: any) => {\n            return (\n              <Tag key={tag} color=\"blue\">\n                {tag.toUpperCase()}\n              </Tag>\n            );\n          })}\n        </span>\n      ),\n    },\n  ];\n\n  const rowSelection = {\n    onChange: (_: React.Key[], selectedRows: TableData[]) => {\n      setSelected(selectedRows)\n    }\n  };\n\n  return (\n    <div>\n      <Row justify=\"end\">\n        <Title level={3}>Users</Title>\n        <Col flex={1} />\n        <Button\n          type=\"primary\"\n          icon={<FontAwesomeIcon icon={faPlus} style={{ marginRight: 10 }} />}\n          onClick={() => setCreateUser(true)}\n        >\n          Add User\n        </Button>\n      </Row>\n      <Table<TableData>\n        columns={columns}\n        dataSource={\n          data\n            ? data.deviceUsers.map(({ id, name }) => ({\n                key: id,\n                name: { id, name },\n                status: \"Active\",\n                services: [\"Hytalk\", \"DEM\"],\n              }))\n            : []\n        }\n        loading={loading}\n        rowSelection={{\n          type: 'checkbox',\n          ...rowSelection\n        }}\n      />\n\n      <AddDeviceUserDrawer\n        companyId={state.id}\n        onClose={() => setCreateUser(false)}\n        visible={createUser}\n      />\n    </div>\n  );\n};\n\nexport default Users;\n","/Users/willgarrod/Projects/gotalk-manage/src/views/app-views/admin-views/companies/company/views/dem/groups.tsx",[],"/Users/willgarrod/Projects/gotalk-manage/src/views/app-views/admin-views/companies/company/views/devices/devices.tsx",[],"/Users/willgarrod/Projects/gotalk-manage/src/views/app-views/admin-views/companies/company/company-context.tsx",[],"/Users/willgarrod/Projects/gotalk-manage/src/views/app-views/admin-views/stock-management/index.tsx",[],"/Users/willgarrod/Projects/gotalk-manage/src/views/app-views/admin-views/stock-management/router.tsx",[],"/Users/willgarrod/Projects/gotalk-manage/src/views/app-views/admin-views/stock-management/dashboard/index.tsx",[],"/Users/willgarrod/Projects/gotalk-manage/src/views/app-views/admin-views/stock-management/dashboard/dashboard.tsx",[],"/Users/willgarrod/Projects/gotalk-manage/src/graphql-src/stock-models/queries/index.ts",[],"/Users/willgarrod/Projects/gotalk-manage/src/graphql-src/stock-items/enums/index.ts",[],"/Users/willgarrod/Projects/gotalk-manage/src/graphql-src/stock-items/enums/stock-type.ts",[],"/Users/willgarrod/Projects/gotalk-manage/src/graphql-src/stock-models/queries/stock-models.ts",[],"/Users/willgarrod/Projects/gotalk-manage/src/graphql-src/stock-models/queries/stock-dashboard.ts",[],"/Users/willgarrod/Projects/gotalk-manage/src/views/app-views/admin-views/stock-management/stock-item/index.tsx",[],"/Users/willgarrod/Projects/gotalk-manage/src/views/app-views/admin-views/stock-management/stock-item/stock-item.tsx",["2931","2932","2933","2934","2935","2936"],"/Users/willgarrod/Projects/gotalk-manage/src/graphql-src/stock-items/queries/index.ts",[],"/Users/willgarrod/Projects/gotalk-manage/src/graphql-src/stock-items/queries/stock-item.ts",[],"/Users/willgarrod/Projects/gotalk-manage/src/graphql-src/stock-items/queries/stock-items.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/index.tsx",[],["2937","2938"],"/Users/willgarrod/Projects/hytalk-manage/src/serviceWorker.js",[],["2939","2940"],"/Users/willgarrod/Projects/hytalk-manage/src/App.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/state/