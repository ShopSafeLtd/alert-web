/src/views/app-views/admin-views/dealers/dealer/views/products.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/components/form-components/dealers/edit/edit-dealer-form.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/components/form-components/dealers/edit/edit-dealer-drawer.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/organisations/mutations/update-organisation.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/components/form-components/products/edit/edit-product-drawer.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/components/form-components/products/edit/edit-product-form.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/products/mutations/update-product.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/app-views/admin-views/dealers/dealer/views/licences.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/components/form-components/licences/index.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/components/form-components/licences/licence-form.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/components/form-components/licences/add/add-licence-form.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/components/form-components/licences/add/add-licence-drawer.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/licenses/mutations/index.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/licenses/mutations/assign-licence.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/licenses/mutations/create-licence.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/currency/queries/index.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/currency/queries/currencies.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/lang/entries/fr_FR.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/components/layout-components/navigation/NavPanel.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/components/layout-components/ThemeConfigurator.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/components/layout-components/navigation/NavLanguage.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/components/shared-components/ColorPicker/index.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/app-views/dealer-views/portal-users/index.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/app-views/dealer-views/portal-users/portal-users-list/index.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/app-views/dealer-views/portal-users/portal-users-list/portal-users-list.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/app-views/router.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/onboarding-views/dealer/router.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/layouts/auth-layout/index.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/layouts/onboarding-layout/index.tsx",["2945"],"import React, { useEffect, useState } from 'react'\nimport { Switch, Route, } from \"react-router-dom\";\nimport { Row, Col, Steps } from \"antd\";\nimport styled from \"styled-components\";\nimport { OnboardingProvider } from './onboarding-context'\n\nimport { useStoreState } from \"state\";\nimport OnboardingViews from 'views/onboarding-views/router'\n\nconst { Step } = Steps\n\nconst Container = styled.div`\n  height: 100vh;\n  max-height: 100vh;\n  padding-top: 5vh;\n  display: flex;\n  flex-direction: column;\n`\n\nconst Content = styled.div`\n  flex: 1;\n  height: 100%;\n  overflow-y: auto;\n`\n\nexport const Onboarding = ({ location }:any) => {\n  const userOnboarding = useStoreState((state) => state.user.onboarded);\n  const orgOnboarding = useStoreState((state) => state.user.organisation?.organisation.onboarded);\n  const [currentStep, setCurrentStep] = useState(0)\n\n  useEffect(() => {\n    if (location.pathname.includes('terms-conditions')) {\n      setCurrentStep(0)\n    } else if (location.pathname.includes('business-details')) {\n      userOnboarding ? setCurrentStep(0) : setCurrentStep(1)\n    } else if (location.pathname.includes('terms-of-business')) {\n      userOnboarding ? setCurrentStep(1) : setCurrentStep(2)\n    } else if (location.pathname.includes('payment-method')) {\n      userOnboarding ? setCurrentStep(2) : setCurrentStep(3)\n    } else if (location.pathname.includes('getting-started')) {\n      userOnboarding ? setCurrentStep(3) : setCurrentStep(4)\n    }\n  }, [location])\n  \n  const backgroundStyle = {\n    height: '100vh',\n\t}\n\n\treturn (\n    <div style={backgroundStyle}>\n      <div className=\"container d-flex flex-column justify-content-center h-100\">\n        <Row justify=\"center\">\n          <Col xs={20} sm={20} md={20} lg={20}>\n            <Container>\n              <Steps current={currentStep} labelPlacement=\"vertical\" size=\"small\">\n                {!userOnboarding && <Step title=\"User Terms\" />}\n                {!orgOnboarding && <Step title=\"Business Details\" />}\n                {!orgOnboarding && <Step title=\"Terms of Business\" />}\n                {!orgOnboarding && <Step title=\"Payment Method\" />}\n                <Step title=\"Getting Started\" />\n              </Steps>\n              <Content className=\"my-4\">\n                <Switch>\n                  <Route path=\"\" component={OnboardingViews} />\n                </Switch>\n              </Content>\n            </Container>\n          </Col>\n        </Row>\n      </div>\n    </div>\n\t\t\t\n\t)\n}\n\n\nconst OnboardingLayout = (props: any) => {\n  return (\n    <OnboardingProvider>\n      <Onboarding {...props} />\n    </OnboardingProvider>\n  )\n}\n\nexport default OnboardingLayout\n","/Users/willgarrod/Projects/hytalk-manage/src/views/onboarding-views/router.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/app-views/admin-views/settings/router.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/app-views/admin-views/settings/dealer-tiers/router.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/app-views/admin-views/settings/dealer-tiers/dealer-tier-list/index.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/app-views/admin-views/settings/dealer-tiers/dealer-tier/index.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/app-views/admin-views/settings/dealer-tiers/dealer-tier/dealer-tier-page.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/app-views/admin-views/settings/dealer-tiers/dealer-tier-list/dealer-tier-list.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/app-views/admin-views/settings/stripe/index.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/app-views/admin-views/settings/stripe/stripe.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/stripe/mutations/index.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/stripe/mutations/sync-customers.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/stripe/mutations/setup-direct-debit.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/stripe/mutations/setup-card.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/app-views/admin-views/settings/terms/router.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/app-views/admin-views/settings/terms/terms-list.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/app-views/admin-views/settings/terms/terms.tsx",["2946"],"import React from \"react\";\nimport { useQuery, useMutation } from '@apollo/client'\nimport { Breadcrumb, Button } from \"antd\";\nimport { Link } from \"react-router-dom\";\nimport { Term, TermArgs, TermRes } from 'graphql-src/terms/queries'\nimport { UpdateTerms, UpdateTermsArgs, UpdateTermsRes} from 'graphql-src/terms/mutations'\nimport { PageHeader } from 'components/layout-components'\nimport { FormData, TermsForm } from 'components/form-components/terms'\nimport { TermsType } from \"graphql-src/terms/enums\";\n\nexport const Terms = ({ match }: any) => {\n  const { data, loading } = useQuery<TermRes, TermArgs>(Term, {\n    variables: {\n      id: match.params.id\n    }\n  })\n  const [updateTerms] = useMutation<UpdateTermsRes, UpdateTermsArgs>(UpdateTerms)\n\n  const handleSubmit = (formData: FormData) => {  \n    updateTerms({\n      variables: {\n        id: match.params.id,\n        content: { set: formData.content },\n        description: { set: formData.description },\n        name: { set: formData.name },\n        version: { set: formData.version },\n        type: { set: formData.type }\n      },\n      optimisticResponse: {\n        updateOneTerm: {\n          content: formData.content,\n          description: formData.description,\n          id: match.params.id,\n          name: formData.name,\n          version: formData.version,\n          defaultOrg: data?.term.defaultOrg!,\n          defaultUser: data?.term.defaultUser!,\n          type: formData.type\n        }\n      }\n    })\n  }\n\n  const makeDefaultUser = () => {\n    updateTerms({\n      variables: {\n        id: match.params.id,\n        content: { set: data?.term.content! },\n        description: { set: data?.term.description! },\n        name: { set: data?.term.name! },\n        version: { set: data?.term.version! },\n        defaultUser: { set: true },\n        type: { set: data?.term.type! }\n      },\n      optimisticResponse: {\n        updateOneTerm: {\n          content: data?.term.content!,\n          description: data?.term.description!,\n          id: match.params.id,\n          name:  data?.term.name!,\n          version: data?.term.version!,\n          defaultOrg: data?.term.defaultOrg!,\n          defaultUser: true,\n          type: data?.term.type!\n        }\n      }\n    })\n  }\n\n  const makeDefaultOrg = () => {\n    updateTerms({\n      variables: {\n        id: match.params.id,\n        content: { set: data?.term.content! },\n        description: { set: data?.term.description! },\n        name: { set: data?.term.name! },\n        version: { set: data?.term.version! },\n        defaultOrg: { set: true },\n        type: { set: data?.term.type! }\n      },\n      optimisticResponse: {\n        updateOneTerm: {\n          content: data?.term.content!,\n          description: data?.term.description!,\n          id: match.params.id,\n          name:  data?.term.name!,\n          version: data?.term.version!,\n          defaultOrg: true,\n          defaultUser: data?.term.defaultUser!,\n          type: data?.term.type!\n        }\n      }\n    })\n  }\n\n  console.log(data)\n\n  return (\n    <div style={{ flex: 1, overflow: 'auto', width: '100%' }}>\n      <PageHeader\n        title={data?.term.name}\n        display\n        noTranslate\n        breadcrumbs={\n          <Breadcrumb>\n            <Breadcrumb.Item>Settings</Breadcrumb.Item>\n            <Breadcrumb.Item>\n              <Link to=\"/app/settings/terms\">Terms</Link>\n            </Breadcrumb.Item>\n            <Breadcrumb.Item>{data?.term.name}</Breadcrumb.Item>\n          </Breadcrumb>\n        }\n        actions={data?.term.type === TermsType.business ? [\n          <Button key=\"0\" disabled={data.term.defaultOrg} type=\"primary\" onClick={makeDefaultOrg}>Make Default</Button>\n        ] : data?.term.type === TermsType.user ? [\n          <Button key=\"0\" disabled={data.term.defaultUser} type=\"primary\" onClick={makeDefaultUser}>Make Default</Button>\n        ] : undefined}\n      />\n      <TermsForm\n        onSubmit={handleSubmit}\n        data={data?.term}\n      />\n    </div>\n  );\n};","/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/terms/queries/index.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/terms/queries/terms.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/app-views/admin-views/settings/terms/create-terms.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/terms/mutations/index.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/terms/mutations/create-terms.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/terms/queries/term.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/components/form-components/terms/index.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/components/form-components/terms/terms-form.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/terms/mutations/update-terms.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/terms/enums/index.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/terms/enums/terms-type.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/onboarding-views/dealer/views/business-details.tsx",["2947"],"import React, { useEffect, useRef } from \"react\";\nimport { Row, Col, Typography, Button, Form, Input, FormInstance } from \"antd\";\nimport styled from \"styled-components\";\nimport { useMutation } from \"@apollo/client\";\nimport { Grow } from \"components/layout-components\";\nimport {\n  UpdateBusinessDetails,\n  UpdateBusinessDetailsArgs,\n  UpdateBusinessDetailsRes,\n} from \"graphql-src/organisations/mutations\";\nimport { useStoreState } from \"state\";\nimport { useOnboarding } from \"layouts/onboarding-layout/onboarding-context\";\nimport { OnboardingStep } from \"graphql-src/organisations/enums\";\n\nconst { Text, Title } = Typography;\n\nconst Content = styled.div`\n  width: 100%;\n  overflow: hidden;\n  padding-top: 20px;\n`;\n\nexport interface FormData {\n  name: string;\n  street1: string;\n  street2: string;\n  city: string;\n  county: string;\n  country: string;\n  postcode: string;\n  accountsContact: string;\n  accountsEmail: string;\n  accountsPhone: string;\n}\n\ninterface Props {\n  match: any;\n  history: any;\n}\n\nexport const BusinessDetails = (props: Props) => {\n  const formRef = useRef<FormInstance<FormData>>(null);\n  const id = useStoreState(state => state.user.organisation?.organisation.id)\n  const onboardingStep = useStoreState(state => state.user.organisation?.organisation.onboardingStep)\n  const { state } = useOnboarding()\n  const [updateDetails] = useMutation<UpdateBusinessDetailsRes, UpdateBusinessDetailsArgs>(UpdateBusinessDetails)\n\n  useEffect(() => {\n    if (state.details) {\n      formRef.current?.setFieldsValue(state.details);\n    }\n  }, [state])\n\n  useEffect(() => {\n    if (onboardingStep === OnboardingStep.terms) {\n      props.history.push('/onboarding/dealer/terms-of-business')\n    } else if (onboardingStep === OnboardingStep.payment) {\n      props.history.push('/onboarding/dealer/payment-method/processing')\n    }\n  }, [onboardingStep])\n\n\n  const handleSubmit = async (data: FormData) => {\n    updateDetails({\n      variables: {\n        data: {\n          accountsContact: { set: data.accountsContact },\n          street1: { set: data.street1 },\n          street2: { set: data.street2 },\n          city: { set: data.city },\n          county: { set: data.county },\n          country: { set: data.country },\n          postcode: { set: data.postcode },\n          accountsEmail: { set: data.accountsEmail },\n          accountsPhone: { set: data.accountsPhone },\n          name: { set: data.name }\n        },\n        id: id!\n      }\n    })\n    props.history.push(\"/onboarding/dealer/terms-of-business\");\n  };\n\n  return (\n    <Content>\n      <Form<FormData>\n        name=\"basic\"\n        ref={formRef}\n        onFinish={handleSubmit}\n        onFinishFailed={() => {}}\n        style={{ display: \"flex\", flexDirection: \"column\", flex: 1 }}\n        initialValues={{\n          name: \"\",\n          parent: \"\",\n        }}\n        layout=\"vertical\"\n      >\n        <Title level={4}>Please enter your business details</Title>\n        <Row className=\"mt-3\">\n          <Col span={12}>\n            <Form.Item\n              label=\"Business Name\"\n              name=\"name\"\n              rules={[\n                { required: true, message: \"Please complete this field.\" },\n              ]}\n            >\n              <Input\n                disabled={!state.details}\n              />\n            </Form.Item>\n          </Col>\n        </Row>\n        <Title level={5} style={{ fontSize: 16, marginBottom: 0 }}>\n          Invoice Address\n        </Title>\n        <Row className=\"mt-2\" gutter={16}>\n          <Col span={12}>\n            <Form.Item\n              label=\"Line 1\"\n              name=\"street1\"\n              rules={[\n                { required: true, message: \"Please complete this field.\" },\n              ]}\n            >\n              <Input disabled={!state.details} />\n            </Form.Item>\n          </Col>\n          <Col span={12}>\n            <Form.Item\n              label=\"Line 2\"\n              name=\"street2\"\n              rules={[\n                { required: true, message: \"Please complete this field\" },\n              ]}\n            >\n              <Input disabled={!state.details} />\n            </Form.Item>\n          </Col>\n        </Row>\n        <Row className=\"mt-2\" gutter={16}>\n          <Col span={12}>\n            <Form.Item\n              label=\"City\"\n              name=\"city\"\n              rules={[\n                { required: true, message: \"Please complete this field\" },\n              ]}\n            >\n              <Input disabled={!state.details} />\n            </Form.Item>\n          </Col>\n          <Col span={12}>\n            <Form.Item\n              label=\"County/State\"\n              name=\"county\"\n              rules={[\n                { required: true, message: \"Please complete this field.\" },\n              ]}\n            >\n              <Input disabled={!state.details} />\n            </Form.Item>\n          </Col>\n        </Row>\n        <Row className=\"mt-2\" gutter={16}>\n          <Col span={12}>\n            <Form.Item\n              label=\"Country\"\n              name=\"country\"\n              rules={[\n                { required: true, message: \"Please complete this field\" },\n              ]}\n            >\n              <Input disabled={!state.details} />\n            </Form.Item>\n          </Col>\n          <Col span={12}>\n            <Form.Item\n              label=\"Postcode\"\n              name=\"postcode\"\n              rules={[\n                { required: true, message: \"Please complete this field.\" },\n              ]}\n            >\n              <Input disabled={!state.details} />\n            </Form.Item>\n          </Col>\n        </Row>\n\n        <Title level={5} style={{ fontSize: 16, marginBottom: 0 }}>\n          Accounts Contact\n        </Title>\n        <Text style={{ fontSize: 13 }}>\n          Please provide the contact details for the person who will receive\n          invoices and all accounts related enquiries.\n        </Text>\n        <Row className=\"mt-3\" gutter={16}>\n          <Col span={12}>\n            <Form.Item\n              label=\"Name\"\n              name=\"accountsContact\"\n              rules={[\n                { required: true, message: \"Please complete this field\" },\n              ]}\n            >\n              <Input disabled={!state.details} />\n            </Form.Item>\n          </Col>\n          <Col span={12}>\n            <Form.Item\n              label=\"Email\"\n              name=\"accountsEmail\"\n              rules={[\n                { required: true, message: \"Please complete this field\" },\n                {\n                  type: \"email\",\n                  message: \"Please enter a valid email address\",\n                },\n              ]}\n            >\n              <Input disabled={!state.details} />\n            </Form.Item>\n          </Col>\n        </Row>\n        <Row gutter={16}>\n          <Col span={12}>\n            <Form.Item\n              label=\"Phone Number\"\n              name=\"accountsPhone\"\n              rules={[\n                { required: true, message: \"Please complete this field\" },\n              ]}\n            >\n              <Input disabled={!state.details} />\n            </Form.Item>\n          </Col>\n        </Row>\n\n        <Grow />\n\n        <Form.Item>\n          <Row justify=\"end\">\n            <Button type=\"primary\" htmlType=\"submit\" disabled={!state.details}>\n              Submit\n            </Button>\n          </Row>\n        </Form.Item>\n      </Form>\n    </Content>\n  );\n};\n","/Users/willgarrod/Projects/hytalk-manage/src/views/onboarding-views/dealer/views/payment-method.tsx",["2948"],"import React, { useEffect, useState } from \"react\";\nimport { useMutation } from \"@apollo/client\";\nimport { useStripe } from \"@stripe/react-stripe-js\";\nimport { Spin, Typography, Card, Row, Col } from \"antd\";\nimport { FontAwesomeIcon } from \"@fortawesome/react-fontawesome\";\nimport { faCreditCard, faUniversity } from \"@fortawesome/pro-light-svg-icons\";\nimport {\n  faLongArrowRight,\n  IconDefinition,\n} from \"@fortawesome/pro-solid-svg-icons\";\n\nimport { useStoreState } from \"state\";\nimport {\n  SetupDirectDebit,\n  SetupDirectDebitRes,\n  SetupDirectDebitArgs,\n  SetupCard,\n  SetupCardArgs,\n  SetupCardRes,\n} from \"graphql-src/stripe/mutations\";\n\nconst { Title, Paragraph } = Typography;\n\ninterface OptionProps {\n  text: string;\n  icon: IconDefinition;\n  onClick(): void;\n  disabled: boolean;\n}\n\nconst Option = ({ text, icon, onClick, disabled }: OptionProps) => {\n  const [hover, setHover] = useState(false);\n\n  return (\n    <Card\n      className=\"mt-3\"\n      style={{\n        cursor: disabled ?  \"default\" : \"pointer\",\n        opacity: disabled ? .5 : 1\n      }}\n      onMouseEnter={() => !disabled && setHover(true)}\n      onMouseLeave={() => setHover(false)}\n      onClick={() => !disabled && onClick()}\n    >\n      <Row align=\"middle\">\n        <Col>\n          <div\n            style={{\n              display: \"flex\",\n              justifyContent: \"center\",\n              alignItems: \"center\",\n              height: 55,\n              width: 55,\n              borderRadius: 100,\n              backgroundColor: hover ? \"#21B573\" : \"#EEEEEE\",\n            }}\n          >\n            <FontAwesomeIcon\n              icon={icon}\n              style={{\n                fontSize: 28,\n                color: hover ? \"#FFF\" : \"rgb(69, 85, 96)\",\n              }}\n            />\n          </div>\n        </Col>\n        <Col className=\"ml-4\" flex={1}>\n          <Title\n            style={{ marginBottom: 0, color: hover ? \"#21B573\" : \"#424242\" }}\n            level={4}\n          >\n            {text}\n          </Title>\n        </Col>\n        <Col>\n          {!disabled ? <FontAwesomeIcon\n            style={{ fontSize: 28, color: hover ? \"#21B573\" : \"#424242\" }}\n            icon={faLongArrowRight}\n          /> : <Spin />}\n        </Col>\n      </Row>\n    </Card>\n  );\n};\n\nexport const PaymentMethod = ({ match, history }: any) => {\n  const stripe = useStripe();\n  const [loading, setLoading] = useState(false)\n\n  const [getDirectDebitSession] = useMutation<\n    SetupDirectDebitRes,\n    SetupDirectDebitArgs\n  >(SetupDirectDebit);\n\n  const [getCardSession] = useMutation<SetupCardRes, SetupCardArgs>(SetupCard);\n\n  const organisationId = useStoreState(\n    (state) => state.user.organisation?.organisation.id\n  );\n\n  useEffect(() => {\n    if (match.params.status === \"success\")\n      history.push(\"/onboarding/dealer/getting-started\");\n  }, [match]);\n\n  const setupDirectDebit = async () => {\n    try {\n      setLoading(true)\n      const session = await getDirectDebitSession({\n        variables: {\n          where: { id: organisationId! },\n        },\n      });\n      stripe?.redirectToCheckout({\n        sessionId: session.data?.setupDirectDebit.id!,\n      });\n    } catch (e) {\n      console.log(e);\n    }\n  };\n\n  const setupCard = async () => {\n    try {\n      setLoading(true)\n      const session = await getCardSession({\n        variables: {\n          where: { id: organisationId! },\n        },\n      });\n      stripe?.redirectToCheckout({\n        sessionId: session.data?.setupCard.id!,\n      });\n    } catch (e) {\n      console.log(e);\n    }\n  };\n\n  return (\n    <div style={{ maxWidth: '100%' }}>\n      <Title level={3}>Please setup you payment method</Title>\n      <Paragraph>\n        You will be automatically invoiced and charged through this payment\n        method for the licences and services that you purchase through Hytalk.\n        You can pay for your services either through direct debit or\n        debit/credit card.\n      </Paragraph>\n      <Row gutter={16}>\n        <Col span=\"12\">\n          <Option icon={faUniversity} text=\"Pay via Direct Debit\" onClick={setupDirectDebit} disabled={loading} />\n        </Col>\n        <Col span=\"12\">\n          <Option icon={faCreditCard} text=\"Pay via Card\" onClick={setupCard} disabled={loading} />\n        </Col>\n      </Row>\n    </div>\n  );\n};\n","/Users/willgarrod/Projects/hytalk-manage/src/views/onboarding-views/dealer/views/terms-conditions.tsx",["2949","2950"],"import React, { useEffect, useState } from \"react\";\nimport { Row, Col, Typography, Button, Checkbox } from \"antd\";\nimport styled from 'styled-components'\nimport { Link } from 'react-router-dom'\nimport ReactMarkdown from 'react-markdown'\nimport { useMutation } from \"@apollo/client\";\nimport { AgreeTerms, AgreeTermsArgs, AgreeTermsRes } from \"graphql-src/users/mutations\";\nimport { useOnboarding } from 'layouts/onboarding-layout/onboarding-context'\nimport { useStoreState } from \"state\";\n\nconst { Title } = Typography\n\nconst Content = styled.div`\n  height: calc(100% - 80px);\n`\nconst Terms = styled.div`\n  overflow: auto;\n`\n\ninterface Props {\n  match: any;\n  history: any;\n}\n\nexport const TermConditions = (props: Props) => {\n  const [agree, setAgree] = useState(false)\n  const { state } = useOnboarding()\n  const id = useStoreState(state => state.user.id)\n  const onboarded = useStoreState(state => state.user.onboarded)\n  const [agreeTerms] = useMutation<AgreeTermsRes, AgreeTermsArgs>(AgreeTerms)\n\n  useEffect(() => {\n    if (onboarded)\n      props.history.push('/onboarding/dealer/business-details')\n  }, [onboarded])\n\n  const handleSubmit = () => {\n    if (state.userTerms) {\n      agreeTerms({\n        variables: {\n          id,\n          termsAgreement: {\n            create: {\n              terms: {\n                connect: {\n                  id: state.userTerms.id!\n                }\n              }\n            }\n          }\n        },\n        optimisticResponse: {\n          user: {\n            id,\n            termsAgreement: {\n              expired: false,\n              id: '0'\n            }\n          }\n        }\n      })\n      props.history.push('business-details')\n    }\n  }\n\n  return (\n    <Content>\n      <Title level={3}>Hytalk User Terms &amp; Conditions</Title>\n      <Terms>\n        <ReactMarkdown children={state.userTerms ? state.userTerms.content : ''} />\n        <Row justify=\"end\" className=\"mt-4\">\n          <Col>\n            <Checkbox disabled={!state.userTerms} value={agree} onChange={() => setAgree(!agree)}>I agree to the terms and conditions</Checkbox>\n          </Col>\n        </Row>\n        <Row justify=\"end\" className=\"mt-2 pb-5\">\n          <Col>\n            <Button disabled={!agree} type=\"primary\" onClick={handleSubmit}>Next</Button>\n          </Col>\n        </Row>\n      </Terms>\n      \n    </Content>\n  );\n};","/Users/willgarrod/Projects/hytalk-manage/src/views/onboarding-views/dealer/views/terms-of-business.tsx",["2951","2952","2953","2954","2955","2956","2957"],"import React, { useState, useRef, useEffect } from \"react\";\nimport { Row, Col, Typography, Button, Form, Input } from \"antd\";\nimport styled from \"styled-components\";\nimport { useMutation } from \"@apollo/client\";\nimport Signature from \"react-signature-canvas\";\nimport { useOnboarding } from 'layouts/onboarding-layout/onboarding-context'\nimport ReactMarkdown from 'react-markdown'\nimport { SignTerms, SignTermsArgs, SignTermsRes } from \"graphql-src/organisations/mutations\";\n\nconst { Paragraph, Title } = Typography;\n\nconst Content = styled.div`\n  height: calc(100% - 80px);\n`;\nconst Terms = styled.div`\n  overflow: auto;\n`;\n\ntype ReactSignatureCanvas = Signature\n\ninterface SignatureInputProps {\n  value?: any;\n  onChange?: (value: any) => void;\n}\n\nconst SignatureInput = ({ onChange, value }: SignatureInputProps) => {\n  const signatureRef = useRef<ReactSignatureCanvas | null>(null)\n\n  const onClear = () => {\n    signatureRef?.current?.clear()\n  }\n\n  const handleChange = () => {\n    onChange && onChange(signatureRef?.current?.toDataURL()!)\n  }\n\n  return (\n    <div>\n      <Signature\n        ref={signatureRef}\n        canvasProps={{\n          width: 400,\n          height: 120,\n          className: \"sigCanvas\",\n          style: {\n            border: \"1px #adadad solid\",\n            borderRadius: 10\n          },\n        }}\n        onEnd={handleChange}\n      />\n      <Button size=\"small\" onClick={onClear}>Clear</Button>\n    </div>\n    \n  );\n};\n\ninterface Props {\n  match: any;\n  history: any;\n}\n\nexport const TermsOfBusiness = (props: Props) => {\n  const { state } = useOnboarding()\n\n  const onSubmit = () => {\n    props.history.push('/onboarding/dealer/payment-method/processing')\n  }\n\n  return (\n    <Content>\n      <Title level={3}>Terms of Business</Title>\n      <Terms>\n        <ReactMarkdown children={state.businessTerms ? state.businessTerms.content : ''} />\n        <Form layout=\"vertical\" onFinish={onSubmit}>\n          <Row className=\"mt-5\">\n            <Col span=\"6\" />\n            <Col span=\"10\">\n              <Form.Item\n                label=\"Signature\"\n                name=\"signature\"\n                rules={[\n                  {\n                    required: true,\n                    message: \"Please sign the terms of business\",\n                  },\n                ]}\n              >\n                <SignatureInput />\n              </Form.Item>\n            </Col>\n            <Col span=\"8\">\n              <Form.Item\n                label=\"Full Name\"\n                name=\"name\"\n                rules={[\n                  { required: true, message: \"Please complete this field.\" },\n                ]}\n              >\n                <Input />\n              </Form.Item>\n              <Form.Item\n                label=\"Job Title\"\n                name=\"jobTitle\"\n                rules={[\n                  { required: true, message: \"Please complete this field.\" },\n                ]}\n              >\n                <Input />\n              </Form.Item>\n            </Col>\n          </Row>\n          <Form.Item>\n            <Row justify=\"end\">\n              <Button type=\"primary\" htmlType=\"submit\">\n                Agree to Terms\n              </Button>\n            </Row>\n          </Form.Item>\n        </Form>\n      </Terms>\n    </Content>\n  );\n};\n","/Users/willgarrod/Projects/hytalk-manage/src/layouts/onboarding-layout/onboarding-context.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/terms/queries/terms-with-content.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/users/mutations/agree-terms.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/organisations/mutations/update-business-details.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/organisations/queries/business-details.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/organisations/enums/onboarding-step.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/organisations/mutations/sign-terms.ts",[],"/Users/willgarrod/Projects/signup-web/src/index.tsx",