/delete-tag.ts",[],"/Users/james/Documents/alert-web-2/src/graphql-src/tags/mutations/create-tag.ts",[],"/Users/james/Documents/alert-web-2/src/graphql-src/chat/mutations/update-chat.ts",[],"/Users/james/Documents/alert-web-2/src/graphql-src/chat/mutations/create-message.ts",[],"/Users/james/Documents/alert-web-2/src/graphql-src/chat/mutations/create-chat.ts",[],"/Users/james/Documents/alert-web-2/src/views/auth-views/components/LoginForm.tsx",[],"/Users/james/Documents/alert-web-2/src/old-components/account/CheckPassword.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/account/ResetPasswordForm.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/admin/crime-types/EditCrimeType.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/admin/crime-types/AddCrimeType.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/admin/crime-types/CrimeTypeList.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/admin/offender-warnings/EditOffenderWarnings.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/admin/offender-warnings/OffenderWarningsList.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/admin/AutoApprove.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/admin/SchemeDetails.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/admin/chat-groups/list/ChatGroups.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/admin/chat-groups/view/ViewChatGroup.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/admin/chat-groups/add/AddChatGroup.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/admin/AdminMenu.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/groups/view/ViewGroup/ViewGroup.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/groups/add/AddGroup/AddGroup.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/groups/list/AllGroups/AllGroups.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/users/view/ViewUser/ViewUser.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/users/add/AddUser/AddUser.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/users/list/AllUsers/AllUsers.jsx",[],"/Users/james/Documents/alert-web-2/src/assets/svg/icon.js",[],"/Users/james/Documents/alert-web-2/src/components/layout-components/navigation/TopNav.tsx",[],"/Users/james/Documents/alert-web-2/src/components/layout-components/navigation/SideNav.tsx",[],"/Users/james/Documents/alert-web-2/src/hooks/useAuth.ts",[],"/Users/james/Documents/alert-web-2/src/old-components/global/images/WebAddImages/WebAddImages.jsx",[],"/Users/james/Documents/alert-web-2/src/lang/entries/en_US.ts",[],"/Users/james/Documents/alert-web-2/src/lang/entries/fr_FR.ts",[],"/Users/james/Documents/alert-web-2/src/old-components/admin/chat-groups/add/Users/Users.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/admin/chat-groups/add/Details/Details.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/groups/add/Users/Users.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/groups/add/Details/Details.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/admin/chat-groups/view/desktop/Desktop/Desktop.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/admin/chat-groups/view/mobile/Mobile/Mobile.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/groups/view/desktop/ViewGroupDesktop/ViewGroupDesktop.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/users/add/Details/Details.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/users/add/Groups/Groups.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/users/add/ChatGroups/ChatGroups.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/users/view/desktop/ViewUserDesktop/ViewUserDesktop.jsx",[],"/Users/james/Documents/alert-web-2/src/components/util-components/CustomIcon/index.tsx",[],"/Users/james/Documents/alert-web-2/src/graphql-src/schemes/mutations/index.ts",[],"/Users/james/Documents/alert-web-2/src/graphql-src/schemes/queries/index.ts",[],"/Users/james/Documents/alert-web-2/src/old-components/admin/chat-groups/view/mobile/Users/Users.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/admin/chat-groups/view/mobile/Details/Details.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/admin/chat-groups/view/desktop/Details/Details.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/admin/chat-groups/view/desktop/Users/Users.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/admin/chat-groups/view/desktop/EditDetailsPopOver/EditDetailsPopOver.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/admin/chat-groups/view/desktop/EditUsersPopOver/EditUsersPopOver.jsx",[],"/Users/james/Documents/alert-web-2/src/graphql-src/groups/mutations/index.ts",[],"/Users/james/Documents/alert-web-2/src/graphql-src/schemes/queries/auto-approve.ts",[],"/Users/james/Documents/alert-web-2/src/graphql-src/schemes/mutations/update-scheme.ts",[],"/Users/james/Documents/alert-web-2/src/graphql-src/schemes/queries/scheme.ts",[],"/Users/james/Documents/alert-web-2/src/graphql-src/schemes/mutations/update-auto-approve.ts",[],"/Users/james/Documents/alert-web-2/src/graphql-src/groups/mutations/update-group.ts",[],"/Users/james/Documents/alert-web-2/src/graphql-src/groups/mutations/create-group.ts",[],"/Users/james/Documents/alert-web-2/src/images/AddGroup.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/users/view/desktop/UserActions/UserActions.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/users/view/desktop/Header/Header.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/users/view/desktop/ChatsGroups/ChatGroups.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/users/view/desktop/Groups/Groups.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/users/view/desktop/Details/Details.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/users/view/desktop/EditChatsPopOver/EditChatsPopOver.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/users/view/desktop/EditDetailsPopOver/EditDetailsPopOver.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/users/view/desktop/EditGroupsPopOver/EditGroupsPopOver.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/groups/view/desktop/Users/Users.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/groups/view/desktop/Details/Details.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/groups/view/desktop/EditUsersPopOver/EditUsersPopOver.jsx",[],"/Users/james/Documents/alert-web-2/src/old-components/groups/view/desktop/EditDetailsPopOver/EditDetailsPopOver.jsx",[],"/Users/james/Documents/alert-web-2/src/types/index.ts",[],"/Users/james/Documents/alert-web-2/src/types/enums/index.ts",[],"/Users/james/Documents/alert-web-2/src/types/enums/account-types.ts",[],"/Users/james/Documents/alert-web-2/src/types/enums/roles.ts",[],"/Users/james/Documents/alert-web-2/src/old-components/admin/recycle-bin/index.js",[],"/Users/james/Documents/alert-web-2/src/old-components/admin/recycle-bin/RecycleBin.jsx",[],"/Users/james/Documents/alert-web-2/src/graphql-src/recycled/queries/index.ts",[],"/Users/james/Documents/alert-web-2/src/graphql-src/recycled/queries/recycled-items.ts",[],"/Users/james/Documents/alert-web-2/src/graphql-src/recycled/mutations/index.ts",[],"/Users/james/Documents/alert-web-2/src/graphql-src/recycled/mutations/restore-incident.ts",[],"/Users/james/Documents/alert-web-2/src/graphql-src/recycled/mutations/restore-offender.ts",[],"/Users/james/Documents/alert-web-2/src/graphql-src/incidents/mutations/delete-incident.ts",[],"/Users/james/Documents/alert-web-2/src/views/app-views/onboarding/router.tsx",[],"/Users/james/Documents/alert-web-2/src/old-components/users/onboard/UserOnboard/UserOnboard.jsx",["1950","1951","1952"],"import React, { useState, useEffect } from \"react\";\nimport styled from \"styled-components\";\nimport MediaQuery from \"react-responsive\";\nimport { Route } from \"react-router-dom\";\nimport { useQuery, useMutation } from \"@apollo/client\";\nimport Paper from \"@material-ui/core/Paper\";\nimport Stepper from \"@material-ui/core/Stepper\";\nimport Step from \"@material-ui/core/Step\";\nimport StepLabel from \"@material-ui/core/StepLabel\";\nimport { withStyles } from \"@material-ui/styles\";\n// import validate from \"validate.js\";\nimport { APP_PREFIX_PATH } from \"configs/AppConfig\";\n\nimport {\n  BackButton,\n  FullWidthButton,\n  ProgressButton,\n} from \"../../../global/actions\";\nimport Welcome from \"../Welcome/Welcome\";\nimport Password from \"../Password/Password\";\nimport Account from \"../Account/Account\";\nimport Terms from \"../Terms/Terms\";\n// import query from '../../../../graphql/users/queries/UserOnboard';\n// import ResetPassword from '../../../../graphql/account/mutations/ResetPasswordMutation';\n// import EditUser from '../../../../graphql/account/mutations/EditProfileMutation';\nimport { useStoreActions, useStoreState } from \"../../../../state\";\n\nconst styles = {\n  label: {\n    fontSize: \"14px\",\n  },\n};\n\nconst Container = styled.div`\n  min-height: calc(100vh);\n  width: 100%;\n  display: flex;\n  justify-content: center;\n  @media (min-width: 1024px) {\n    height: calc(100vh);\n  }\n`;\nconst Page = styled.div`\n  flex: 1;\n  width: 100%;\n  display: flex;\n  flex-direction: column;\n  @media (min-width: 1024px) {\n    padding: 15px 20px;\n    max-width: 1200px;\n  }\n`;\nconst FormContainer = styled(Paper)`\n  flex: 1;\n  display: flex;\n  width: 100%;\n  flex-direction: column;\n`;\nconst Actions = styled.div`\n  display: flex;\n  width: 100%;\n  justify-content: flex-end;\n  @media (min-width: 1024px) {\n    padding: 20px 90px 40px;\n  }\n`;\nconst Content = styled.div`\n  flex: 1;\n  display: flex;\n  padding: 15px 20px;\n  @media (min-width: 1024px) {\n    overflow: auto;\n    padding: 0px 90px;\n  }\n`;\n\nconst UserOnboarding = ({ history, classes }) => {\n  const setUser = useStoreActions((actions) => actions.user.setUser);\n  const currentStep = useStoreState((state) => state.user.onboardSteps);\n\n  // globals\n  const steps = [\n    {\n      step: 0,\n      label: \"Welcome\",\n      url: `${APP_PREFIX_PATH}/onboarding`,\n      next: \"Get Started\",\n    },\n    {\n      step: 1,\n      label: \"Set Password\",\n      url: `${APP_PREFIX_PATH}/onboarding/password`,\n      next: \"Set Password\",\n    },\n    {\n      step: 2,\n      label: \"Account Details\",\n      url: `${APP_PREFIX_PATH}/onboarding/account-details`,\n      next: \"Save Details\",\n    },\n    {\n      step: 3,\n      label: \"Terms & Conditions\",\n      url: `${APP_PREFIX_PATH}/onboarding/terms-conditions`,\n      next: \"Agree\",\n    },\n  ];\n\n  // state\n  const [step, setStep] = useState(0);\n  const [password, setPassword] = useState({\n    password: \"\",\n    passwordError: \"\",\n    confirm: \"\",\n    confirmError: \"\",\n  });\n  const [details, setDetails] = useState({\n    fullName: \"\",\n    fullNameError: \"\",\n    organisation: \"\",\n    organisationError: \"\",\n    premises: \"\",\n    building: \"\",\n    street: \"\",\n    streetError: \"\",\n    townCity: \"\",\n    townCityError: \"\",\n    county: \"\",\n    postcode: \"\",\n    postcodeError: \"\",\n  });\n  const [terms, setTerms] = useState({\n    termsSigned: false,\n    error: \"\",\n  });\n\n  // effects\n  useEffect(() => {\n    if (currentStep === \"WELCOME\") {\n      history.push(`${APP_PREFIX_PATH}/onboarding`);\n      setStep(0);\n    }\n    if (currentStep === \"PASSWORD\") {\n      history.push(`${APP_PREFIX_PATH}/onboarding/password`);\n      setStep(1);\n    }\n    if (currentStep === \"DETAILS\") {\n      history.push(`${APP_PREFIX_PATH}/onboarding/account-details`);\n      setStep(2);\n    }\n    if (currentStep === \"TERMS\") {\n      history.push(`${APP_PREFIX_PATH}/onboarding/terms-conditions`);\n      setStep(3);\n    }\n    // eslint-disable-next-line\n  }, []);\n\n  // queries\n  // const { data, loading } = useQuery(query, {\n  //   fetchPolicy: \"cache-and-network\",\n  //   onCompleted: ({ currentUser: { fullName, organisation, addresses } }) =>\n  //     setDetails({\n  //       ...details,\n  //       fullName,\n  //       organisation,\n  //       premises: addresses[0].premises,\n  //       building: addresses[0].building,\n  //       street: addresses[0].street,\n  //       townCity: addresses[0].townCity,\n  //       county: addresses[0].county,\n  //       postcode: addresses[0].postcode,\n  //     }),\n  // });\n  const data = {};\n  const loading = false;\n\n  // mutations\n  // const [updatePassword] = useMutation(ResetPassword);\n  // const [updateUser] = useMutation(EditUser);\n  // functions\n  const validatePassword = () =>\n    new Promise((resolve, reject) => {\n      const regExp = /(?=.*\\d)(?=.*[a-z])(?=.*[A-Z])/;\n      const passwordLong = true;\n      // validate(\n      //   { password: password.password },\n      //   { password: { length: { minimum: 8 } } }\n      // ) === undefined;\n      const passwordComplex = regExp.test(password.password);\n      const passwordsMatch = password.password === password.confirm;\n      setPassword({\n        ...password,\n        passwordError: passwordLong\n          ? passwordComplex\n            ? passwordsMatch\n              ? \"\"\n              : \"Passwords do not match.\"\n            : \"Password must contain at least one number and upper case letter.\"\n          : \"Password must be at least 8 characters long.\",\n        confirmError: passwordsMatch ? \"\" : \"Passwords do not match.\",\n      });\n      passwordLong && passwordComplex && passwordsMatch ? resolve() : reject();\n    });\n  const validateDetails = () =>\n    new Promise((resolve, reject) => {\n      const fullNameValid = !!details.fullName;\n      const organisationValid = !!details.organisation;\n      const streetValid = !!details.street;\n      const townValid = !!details.townCity;\n      const postcodeValid = !!details.postcode;\n\n      setDetails({\n        ...details,\n        fullNameError: fullNameValid ? \"\" : \"This field is required\",\n        organisationError: organisationValid ? \"\" : \"This field is required\",\n        streetError: streetValid ? \"\" : \"This field is required\",\n        townCityError: townValid ? \"\" : \"This field is required\",\n        postcodeError: postcodeValid ? \"\" : \"This field is required\",\n      });\n      fullNameValid &&\n      organisationValid &&\n      streetValid &&\n      townValid &&\n      postcodeValid\n        ? resolve()\n        : reject();\n    });\n  const validateSigned = () =>\n    new Promise((resolve, reject) => {\n      setTerms({\n        ...terms,\n        error: terms.termsSigned\n          ? \"\"\n          : \"Please agree to the terms and conditions\",\n      });\n      terms.termsSigned ? resolve() : reject();\n    });\n\n  const next = () => {\n    history.push(steps[step + 1].url);\n    setStep(step + 1);\n  };\n\n  const handleNext = () => {\n    if (step === 0) {\n      // updateUser({\n      //   variables: {\n      //     id: data.currentUser.id,\n      //     onboardStep: \"PASSWORD\",\n      //   },\n      // });\n      next();\n    }\n    step === 1 &&\n      validatePassword()\n        .then(() => {\n          // updateUser({\n          //   variables: {\n          //     id: data.currentUser.id,\n          //     onboardStep: \"DETAILS\",\n          //   },\n          // });\n          // updatePassword({\n          //   variables: {\n          //     password: password.password,\n          //   },\n          // });\n          next();\n        })\n        .catch(() => {});\n    step === 2 &&\n      validateDetails()\n        .then(() => {\n          // updateUser({\n          //   variables: {\n          //     id: data.currentUser.id,\n          //     onboardStep: \"TERMS\",\n          //     fullName: { set: details.fullName },\n          //     organisation: { set: details.organisation },\n          //     address: {\n          //       where: { id: data.currentUser.addresses[0].id },\n          //       data: {\n          //         premises: { set: details.premises },\n          //         building: { set: details.building },\n          //         street: { set: details.street },\n          //         townCity: { set: details.townCity },\n          //         county: { set: details.county },\n          //         postcode: { set: details.postcode },\n          //       },\n          //     },\n          //   },\n          // });\n          next();\n        })\n        .catch(() => {});\n    step === 3 &&\n      validateSigned()\n        .then(() => {\n          // updateUser({\n          //   variables: {\n          //     id: data.currentUser.id,\n          //     termsSigned: { set: true },\n          //     timeSigned: { set: new Date() },\n          //     newUser: { set: false },\n          //     platform: !!window.navigator.oscpu\n          //       ? { set: window.navigator.oscpu }\n          //       : undefined,\n          //   },\n          // });\n          setUser({ onboarded: true });\n          history.push(\"/\");\n        })\n        .catch(() => {});\n  };\n  const handleBack = () => {\n    history.push(steps[step - 1].url);\n    setStep(step - 1);\n  };\n  const handlePasswordChange = (name) => (event) => {\n    setPassword({\n      ...password,\n      [name]: event.target.value,\n    });\n  };\n  const handleDetailsChange = (name) => (event) => {\n    setDetails({\n      ...details,\n      [name]: event.target.value,\n    });\n  };\n  const handleTermsChange = (name, value) => {\n    setTerms({\n      ...terms,\n      [name]: value,\n    });\n  };\n\n  return (\n    <MediaQuery minDeviceWidth={1024}>\n      {(matches) => (\n        <Container>\n          <Page>\n            <FormContainer elevation={1}>\n              {matches && step > 0 && (\n                <Stepper activeStep={step} alternativeLabel>\n                  {steps.map(({ label, step }) => (\n                    <Step key={step}>\n                      <StepLabel classes={{ label: classes.label }}>\n                        {label}\n                      </StepLabel>\n                    </Step>\n                  ))}\n                </Stepper>\n              )}\n              <Content>\n                <Route\n                  exact\n                  path={`${APP_PREFIX_PATH}/onboarding`}\n                  render={() => <Welcome handleNext={handleNext} />}\n                  mobile={matches}\n                />\n                <Route\n                  path={`${APP_PREFIX_PATH}/onboarding/password`}\n                  render={() => (\n                    <Password\n                      mobile={matches}\n                      handleChange={handlePasswordChange}\n                      values={password}\n                      loading={loading}\n                    />\n                  )}\n                />\n                <Route\n                  path={`${APP_PREFIX_PATH}/onboarding/account-details`}\n                  render={() => (\n                    <Account\n                      handleChange={handleDetailsChange}\n                      values={details}\n                      loading={loading}\n                    />\n                  )}\n                />\n                <Route\n                  path={`${APP_PREFIX_PATH}/onboarding/terms-conditions`}\n                  render={() => (\n                    <Terms\n                      handleChange={handleTermsChange}\n                      values={terms}\n                      loading={loading}\n                    />\n                  )}\n                />\n              </Content>\n              {matches && step > 0 && (\n                <Actions>\n                  {step > 1 && (\