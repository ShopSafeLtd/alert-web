ews/app-views/admin-views/products/products-list/product-list.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/products/queries/index.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/products/queries/products.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/components/form-components/products/index.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/components/form-components/products/add/add-product-form.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/components/form-components/products/add/add-product-drawer.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/components/form-components/products/product-form.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/products/mutations/index.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/products/mutations/create-product.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/licenses/enums/index.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/licenses/enums/billing-period.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/organisation-tiers/queries/index.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/organisation-tiers/queries/organisation-tiers.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/components/form-components/dealer-tiers/index.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/components/form-components/dealer-tiers/add/add-tier-form.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/components/form-components/dealer-tiers/add/add-tier-drawer.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/components/form-components/dealer-tiers/tier-details-form.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/organisation-tiers/mutations/index.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/organisation-tiers/mutations/create-organisation-tier.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/organisation-tiers/queries/organisation-tier.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/app-views/admin-views/products/product/index.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/app-views/admin-views/products/product/product.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/products/queries/product.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/components/shared-components/EditableCell/index.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/app-views/admin-views/dealers/dealer/views/index.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/app-views/admin-views/dealers/dealer/views/overview.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/app-views/admin-views/dealers/dealer/views/products.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/components/form-components/dealers/edit/edit-dealer-form.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/components/form-components/dealers/edit/edit-dealer-drawer.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/organisations/mutations/update-organisation.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/components/form-components/products/edit/edit-product-drawer.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/components/form-components/products/edit/edit-product-form.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/products/mutations/update-product.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/app-views/admin-views/dealers/dealer/views/licences.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/components/form-components/licences/index.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/components/form-components/licences/licence-form.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/components/form-components/licences/add/add-licence-form.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/components/form-components/licences/add/add-licence-drawer.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/licenses/mutations/index.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/licenses/mutations/assign-licence.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/licenses/mutations/create-licence.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/currency/queries/index.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/currency/queries/currencies.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/lang/entries/fr_FR.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/components/layout-components/navigation/NavPanel.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/components/layout-components/ThemeConfigurator.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/components/layout-components/navigation/NavLanguage.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/components/shared-components/ColorPicker/index.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/app-views/dealer-views/portal-users/index.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/app-views/dealer-views/portal-users/portal-users-list/index.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/app-views/dealer-views/portal-users/portal-users-list/portal-users-list.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/app-views/router.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/onboarding-views/dealer/router.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/layouts/auth-layout/index.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/layouts/onboarding-layout/index.tsx",["3368"],"import React, { useEffect, useState } from 'react'\nimport { Switch, Route, } from \"react-router-dom\";\nimport { Row, Col, Steps } from \"antd\";\nimport styled from \"styled-components\";\nimport { OnboardingProvider } from './onboarding-context'\n\nimport { useStoreState } from \"state\";\nimport OnboardingViews from 'views/onboarding-views/router'\n\nconst { Step } = Steps\n\nconst Container = styled.div`\n  height: 100vh;\n  max-height: 100vh;\n  padding-top: 5vh;\n  display: flex;\n  flex-direction: column;\n`\n\nconst Content = styled.div`\n  flex: 1;\n  height: 100%;\n  overflow-y: auto;\n`\n\nexport const Onboarding = ({ location }:any) => {\n  const userOnboarding = useStoreState((state) => state.user.onboarded);\n  const orgOnboarding = useStoreState((state) => state.user.organisation?.organisation.onboarded);\n  const [currentStep, setCurrentStep] = useState(0)\n\n  useEffect(() => {\n    if (location.pathname.includes('terms-conditions')) {\n      setCurrentStep(0)\n    } else if (location.pathname.includes('business-details')) {\n      userOnboarding ? setCurrentStep(0) : setCurrentStep(1)\n    } else if (location.pathname.includes('terms-of-business')) {\n      userOnboarding ? setCurrentStep(1) : setCurrentStep(2)\n    } else if (location.pathname.includes('payment-method')) {\n      userOnboarding ? setCurrentStep(2) : setCurrentStep(3)\n    } else if (location.pathname.includes('getting-started')) {\n      userOnboarding ? setCurrentStep(3) : setCurrentStep(4)\n    }\n  }, [location])\n  \n  const backgroundStyle = {\n    height: '100vh',\n\t}\n\n\treturn (\n    <div style={backgroundStyle}>\n      <div className=\"container d-flex flex-column justify-content-center h-100\">\n        <Row justify=\"center\">\n          <Col xs={20} sm={20} md={20} lg={20}>\n            <Container>\n              <Steps current={currentStep} labelPlacement=\"vertical\" size=\"small\">\n                {!userOnboarding && <Step title=\"User Terms\" />}\n                {!orgOnboarding && <Step title=\"Business Details\" />}\n                {!orgOnboarding && <Step title=\"Terms of Business\" />}\n                {!orgOnboarding && <Step title=\"Payment Method\" />}\n                <Step title=\"Getting Started\" />\n              </Steps>\n              <Content className=\"my-4\">\n                <Switch>\n                  <Route path=\"\" component={OnboardingViews} />\n                </Switch>\n              </Content>\n            </Container>\n          </Col>\n        </Row>\n      </div>\n    </div>\n\t\t\t\n\t)\n}\n\n\nconst OnboardingLayout = (props: any) => {\n  return (\n    <OnboardingProvider>\n      <Onboarding {...props} />\n    </OnboardingProvider>\n  )\n}\n\nexport default OnboardingLayout\n","/Users/willgarrod/Projects/hytalk-manage/src/views/onboarding-views/router.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/app-views/admin-views/settings/router.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/app-views/admin-views/settings/dealer-tiers/router.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/app-views/admin-views/settings/dealer-tiers/dealer-tier-list/index.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/app-views/admin-views/settings/dealer-tiers/dealer-tier/index.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/app-views/admin-views/settings/dealer-tiers/dealer-tier/dealer-tier-page.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/app-views/admin-views/settings/dealer-tiers/dealer-tier-list/dealer-tier-list.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/app-views/admin-views/settings/stripe/index.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/app-views/admin-views/settings/stripe/stripe.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/stripe/mutations/index.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/stripe/mutations/sync-customers.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/stripe/mutations/setup-direct-debit.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/stripe/mutations/setup-card.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/app-views/admin-views/settings/terms/router.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/app-views/admin-views/settings/terms/terms-list.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/app-views/admin-views/settings/terms/terms.tsx",["3369"],"import React from \"react\";\nimport { useQuery, useMutation } from '@apollo/client'\nimport { Breadcrumb, Button } from \"antd\";\nimport { Link } from \"react-router-dom\";\nimport { Term, TermArgs, TermRes } from 'graphql-src/terms/queries'\nimport { UpdateTerms, UpdateTermsArgs, UpdateTermsRes} from 'graphql-src/terms/mutations'\nimport { PageHeader } from 'components/layout-components'\nimport { FormData, TermsForm } from 'components/form-components/terms'\nimport { TermsType } from \"graphql-src/terms/enums\";\n\nexport const Terms = ({ match }: any) => {\n  const { data, loading } = useQuery<TermRes, TermArgs>(Term, {\n    variables: {\n      id: match.params.id\n    }\n  })\n  const [updateTerms] = useMutation<UpdateTermsRes, UpdateTermsArgs>(UpdateTerms)\n\n  const handleSubmit = (formData: FormData) => {  \n    updateTerms({\n      variables: {\n        id: match.params.id,\n        content: { set: formData.content },\n        description: { set: formData.description },\n        name: { set: formData.name },\n        version: { set: formData.version },\n        type: { set: formData.type }\n      },\n      optimisticResponse: {\n        updateOneTerm: {\n          content: formData.content,\n          description: formData.description,\n          id: match.params.id,\n          name: formData.name,\n          version: formData.version,\n          defaultOrg: data?.term.defaultOrg!,\n          defaultUser: data?.term.defaultUser!,\n          type: formData.type\n        }\n      }\n    })\n  }\n\n  const makeDefaultUser = () => {\n    updateTerms({\n      variables: {\n        id: match.params.id,\n        content: { set: data?.term.content! },\n        description: { set: data?.term.description! },\n        name: { set: data?.term.name! },\n        version: { set: data?.term.version! },\n        defaultUser: { set: true },\n        type: { set: data?.term.type! }\n      },\n      optimisticResponse: {\n        updateOneTerm: {\n          content: data?.term.content!,\n          description: data?.term.description!,\n          id: match.params.id,\n          name:  data?.term.name!,\n          version: data?.term.version!,\n          defaultOrg: data?.term.defaultOrg!,\n          defaultUser: true,\n          type: data?.term.type!\n        }\n      }\n    })\n  }\n\n  const makeDefaultOrg = () => {\n    updateTerms({\n      variables: {\n        id: match.params.id,\n        content: { set: data?.term.content! },\n        description: { set: data?.term.description! },\n        name: { set: data?.term.name! },\n        version: { set: data?.term.version! },\n        defaultOrg: { set: true },\n        type: { set: data?.term.type! }\n      },\n      optimisticResponse: {\n        updateOneTerm: {\n          content: data?.term.content!,\n          description: data?.term.description!,\n          id: match.params.id,\n          name:  data?.term.name!,\n          version: data?.term.version!,\n          defaultOrg: true,\n          defaultUser: data?.term.defaultUser!,\n          type: data?.term.type!\n        }\n      }\n    })\n  }\n\n  console.log(data)\n\n  return (\n    <div style={{ flex: 1, overflow: 'auto', width: '100%' }}>\n      <PageHeader\n        title={data?.term.name}\n        display\n        noTranslate\n        breadcrumbs={\n          <Breadcrumb>\n            <Breadcrumb.Item>Settings</Breadcrumb.Item>\n            <Breadcrumb.Item>\n              <Link to=\"/app/settings/terms\">Terms</Link>\n            </Breadcrumb.Item>\n            <Breadcrumb.Item>{data?.term.name}</Breadcrumb.Item>\n          </Breadcrumb>\n        }\n        actions={data?.term.type === TermsType.business ? [\n          <Button key=\"0\" disabled={data.term.defaultOrg} type=\"primary\" onClick={makeDefaultOrg}>Make Default</Button>\n        ] : data?.term.type === TermsType.user ? [\n          <Button key=\"0\" disabled={data.term.defaultUser} type=\"primary\" onClick={makeDefaultUser}>Make Default</Button>\n        ] : undefined}\n      />\n      <TermsForm\n        onSubmit={handleSubmit}\n        data={data?.term}\n      />\n    </div>\n  );\n};","/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/terms/queries/index.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/terms/queries/terms.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/app-views/admin-views/settings/terms/create-terms.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/terms/mutations/index.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/terms/mutations/create-terms.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/terms/queries/term.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/components/form-components/terms/index.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/components/form-components/terms/terms-form.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/terms/mutations/update-terms.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/terms/enums/index.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/terms/enums/terms-type.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/views/onboarding-views/dealer/views/business-details.tsx",["3370"],"import React, { useEffect, useRef } from \"react\";\nimport { Row, Col, Typography, Button, Form, Input, FormInstance } from \"antd\";\nimport styled from \"styled-components\";\nimport { useMutation } from \"@apollo/client\";\nimport { Grow } from \"components/layout-components\";\nimport {\n  UpdateBusinessDetails,\n  UpdateBusinessDetailsArgs,\n  UpdateBusinessDetailsRes,\n} from \"graphql-src/organisations/mutations\";\nimport { useStoreState } from \"state\";\nimport { useOnboarding } from \"layouts/onboarding-layout/onboarding-context\";\nimport { OnboardingStep } from \"graphql-src/organisations/enums\";\n\nconst { Text, Title } = Typography;\n\nconst Content = styled.div`\n  width: 100%;\n  overflow: hidden;\n  padding-top: 20px;\n`;\n\nexport interface FormData {\n  name: string;\n  street1: string;\n  street2: string;\n  city: string;\n  county: string;\n  country: string;\n  postcode: string;\n  accountsContact: string;\n  accountsEmail: string;\n  accountsPhone: string;\n}\n\ninterface Props {\n  match: any;\n  history: any;\n}\n\nexport const BusinessDetails = (props: Props) => {\n  const formRef = useRef<FormInstance<FormData>>(null);\n  const id = useStoreState(state => state.user.organisation?.organisation.id)\n  const onboardingStep = useStoreState(state => state.user.organisation?.organisation.onboardingStep)\n  const { state } = useOnboarding()\n  const [updateDetails] = useMutation<UpdateBusinessDetailsRes, UpdateBusinessDetailsArgs>(UpdateBusinessDetails)\n\n  useEffect(() => {\n    if (state.details) {\n      formRef.current?.setFieldsValue(state.details);\n    }\n  }, [state])\n\n  useEffect(() => {\n    if (onboardingStep === OnboardingStep.terms) {\n      props.history.push('/onboarding/dealer/terms-of-business')\n    } else if (onboardingStep === OnboardingStep.payment) {\n      props.history.push('/onboarding/dealer/payment-method/processing')\n    }\n  }, [onboardingStep])\n\n\n  const handleSubmit = async (data: FormData) => {\n    updateDetails({\n      variables: {\n        data: {\n          accountsContact: { set: data.accountsContact },\n          street1: { set: data.street1 },\n          street2: { set: data.street2 },\n          city: { set: data.city },\n          county: { set: data.county },\n          country: { set: data.country },\n          postcode: { set: data.postcode },\n          accountsEmail: { set: data.accountsEmail },\n          accountsPhone: { set: data.accountsPhone },\n          name: { set: data.name }\n        },\n        id: id!\n      }\n    })\n    props.history.push(\"/onboarding/dealer/terms-of-business\");\n  };\n\n  return (\n    <Content>\n      <Form<FormData>\n        name=\"basic\"\n        ref={formRef}\n        onFinish={handleSubmit}\n        onFinishFailed={() => {}}\n        style={{ display: \"flex\", flexDirection: \"column\", flex: 1 }}\n        initialValues={{\n          name: \"\",\n          parent: \"\",\n        }}\n        layout=\"vertical\"\n      >\n        <Title level={4}>Please enter your business details</Title>\n        <Row className=\"mt-3\">\n          <Col span={12}>\n            <Form.Item\n              label=\"Business Name\"\n              name=\"name\"\n              rules={[\n                { required: true, message: \"Please complete this field.\" },\n              ]}\n            >\n              <Input\n                disabled={!state.details}\n              />\n            </Form.Item>\n          </Col>\n        </Row>\n        <Title level={5} style={{ fontSize: 16, marginBottom: 0 }}>\n          Invoice Address\n        </Title>\n        <Row className=\"mt-2\" gutter={16}>\n          <Col span={12}>\n            <Form.Item\n              label=\"Line 1\"\n              name=\"street1\"\n              rules={[\n                { required: true, message: \"Please complete this field.\" },\n              ]}\n            >\n              <Input disabled={!state.details} />\n            </Form.Item>\n          </Col>\n          <Col span={12}>\n            <Form.Item\n              label=\"Line 2\"\n              name=\"street2\"\n              rules={[\n                { required: true, message: \"Please complete this field\" },\n              ]}\n            >\n              <Input disabled={!state.details} />\n            </Form.Item>\n          </Col>\n        </Row>\n        <Row className=\"mt-2\" gutter={16}>\n          <Col span={12}>\n            <Form.Item\n              label=\"City\"\n              name=\"city\"\n              rules={[\n                { required: true, message: \"Please complete this field\" },\n              ]}\n            >\n              <Input disabled={!state.details} />\n            </Form.Item>\n          </Col>\n          <Col span={12}>\n            <Form.Item\n              label=\"County/State\"\n              name=\"county\"\n              rules={[\n                { required: true, message: \"Please complete this field.\" },\n              ]}\n            >\n              <Input disabled={!state.details} />\n            </Form.Item>\n          </Col>\n        </Row>\n        <Row className=\"mt-2\" gutter={16}>\n          <Col span={12}>\n            <Form.Item\n              label=\"Country\"\n              name=\"country\"\n              rules={[\n                { required: true, message: \"Please complete this field\" },\n              ]}\n            >\n              <Input disabled={!state.details} />\n            </Form.Item>\n          </Col>\n          <Col span={12}>\n            <Form.Item\n              label=\"Postcode\"\n              name=\"postcode\"\n              rules={[\n                { required: true, message: \"Please complete this field.\" },\n              ]}\n            >\n              <Input disabled={!state.details} />\n            </Form.Item>\n          </Col>\n        </Row>\n\n        <Title level={5} style={{ fontSize: 16, marginBottom: 0 }}>\n          Accounts Contact\n        </Title>\n        <Text style={{ fontSize: 13 }}>\n          Please provide the contact details for the person who will receive\n          invoices and all accounts related enquiries.\n        </Text>\n        <Row className=\"mt-3\" gutter={16}>\n          <Col span={12}>\n            <Form.Item\n              label=\"Name\"\n              name=\"accountsContact\"\n              rules={[\n                { required: true, message: \"Please complete this field\" },\n              ]}\n            >\n              <Input disabled={!state.details} />\n            </Form.Item>\n          </Col>\n          <Col span={12}>\n            <Form.Item\n              label=\"Email\"\n              name=\"accountsEmail\"\n              rules={[\n                { required: true, message: \"Please complete this field\" },\n                {\n                  type: \"email\",\n                  message: \"Please enter a valid email address\",\n                },\n              ]}\n            >\n              <Input disabled={!state.details} />\n            </Form.Item>\n          </Col>\n        </Row>\n        <Row gutter={16}>\n          <Col span={12}>\n            <Form.Item\n              label=\"Phone Number\"\n              name=\"accountsPhone\"\n              rules={[\n                { required: true, message: \"Please complete this field\" },\n              ]}\n            >\n              <Input disabled={!state.details} />\n            </Form.Item>\n          </Col>\n        </Row>\n\n        <Grow />\n\n        <Form.Item>\n          <Row justify=\"end\">\n            <Button type=\"primary\" htmlType=\"submit\" disabled={!state.details}>\n              Submit\n            </Button>\n          </Row>\n        </Form.Item>\n      </Form>\n    </Content>\n  );\n};\n","/Users/willgarrod/Projects/hytalk-manage/src/views/onboarding-views/dealer/views/payment-method.tsx",["3371"],"import React, { useEffect, useState } from \"react\";\nimport { useMutation } from \"@apollo/client\";\nimport { useStripe } from \"@stripe/react-stripe-js\";\nimport { Spin, Typography, Card, Row, Col } from \"antd\";\nimport { FontAwesomeIcon } from \"@fortawesome/react-fontawesome\";\nimport { faCreditCard, faUniversity } from \"@fortawesome/pro-light-svg-icons\";\nimport {\n  faLongArrowRight,\n  IconDefinition,\n} from \"@fortawesome/pro-solid-svg-icons\";\n\nimport { useStoreState } from \"state\";\nimport {\n  SetupDirectDebit,\n  SetupDirectDebitRes,\n  SetupDirectDebitArgs,\n  SetupCard,\n  SetupCardArgs,\n  SetupCardRes,\n} from \"graphql-src/stripe/mutations\";\n\nconst { Title, Paragraph } = Typography;\n\ninterface OptionProps {\n  text: string;\n  icon: IconDefinition;\n  onClick(): void;\n  disabled: boolean;\n}\n\nconst Option = ({ text, icon, onClick, disabled }: OptionProps) => {\n  const [hover, setHover] = useState(false);\n\n  return (\n    <Card\n      className=\"mt-3\"\n      style={{\n        cursor: disabled ?  \"default\" : \"pointer\",\n        opacity: disabled ? .5 : 1\n      }}\n      onMouseEnter={() => !disabled && setHover(true)}\n      onMouseLeave={() => setHover(false)}\n      onClick={() => !disabled && onClick()}\n    >\n      <Row align=\"middle\">\n        <Col>\n          <div\n            style={{\n              display: \"flex\",\n              justifyContent: \"center\",\n              alignItems: \"center\",\n              height: 55,\n              width: 55,\n              borderRadius: 100,\n              backgroundColor: hover ? \"#21B573\" : \"#EEEEEE\",\n            }}\n          >\n            <FontAwesomeIcon\n              icon={icon}\n              style={{\n                fontSize: 28,\n                color: hover ? \"#FFF\" : \"rgb(69, 85, 96)\",\n              }}\n            />\n          </div>\n        </Col>\n        <Col className=\"ml-4\" flex={1}>\n          <Title\n            style={{ marginBottom: 0, color: hover ? \"#21B573\" : \"#424242\" }}\n            level={4}\n          >\n            {text}\n          </Title>\n        </Col>\n        <Col>\n          {!disabled ? <FontAwesomeIcon\n            style={{ fontSize: 28, color: hover ? \"#21B573\" : \"#424242\" }}\n            icon={faLongArrowRight}\n          /> : <Spin />}\n        </Col>\n      </Row>\n    </Card>\n  );\n};\n\nexport const PaymentMethod = ({ match, history }: any) => {\n  const stripe = useStripe();\n  const [loading, setLoading] = useState(false)\n\n  const [getDirectDebitSession] = useMutation<\n    SetupDirectDebitRes,\n    SetupDirectDebitArgs\n  >(SetupDirectDebit);\n\n  const [getCardSession] = useMutation<SetupCardRes, SetupCardArgs>(SetupCard);\n\n  const organisationId = useStoreState(\n    (state) => state.user.organisation?.organisation.id\n  );\n\n  useEffect(() => {\n    if (match.params.status === \"success\")\n      history.push(\"/onboarding/dealer/getting-started\");\n  }, [match]);\n\n  const setupDirectDebit = async () => {\n    try {\n      setLoading(true)\n      const session = await getDirectDebitSession({\n        variables: {\n          where: { id: organisationId! },\n        },\n      });\n      stripe?.redirectToCheckout({\n        sessionId: session.data?.setupDirectDebit.id!,\n      });\n    } catch (e) {\n      console.log(e);\n    }\n  };\n\n  const setupCard = async () => {\n    try {\n      setLoading(true)\n      const session = await getCardSession({\n        variables: {\n          where: { id: organisationId! },\n        },\n      });\n      stripe?.redirectToCheckout({\n        sessionId: session.data?.setupCard.id!,\n      });\n    } catch (e) {\n      console.log(e);\n    }\n  };\n\n  return (\n    <div style={{ maxWidth: '100%' }}>\n      <Title level={3}>Please setup you payment method</Title>\n      <Paragraph>\n        You will be automatically invoiced and charged through this payment\n        method for the licences and services that you purchase through Hytalk.\n        You can pay for your services either through direct debit or\n        debit/credit card.\n      </Paragraph>\n      <Row gutter={16}>\n        <Col span=\"12\">\n          <Option icon={faUniversity} text=\"Pay via Direct Debit\" onClick={setupDirectDebit} disabled={loading} />\n        </Col>\n        <Col span=\"12\">\n          <Option icon={faCreditCard} text=\"Pay via Card\" onClick={setupCard} disabled={loading} />\n        </Col>\n      </Row>\n    </div>\n  );\n};\n","/Users/willgarrod/Projects/hytalk-manage/src/views/onboarding-views/dealer/views/terms-conditions.tsx",["3372","3373"],"import React, { useEffect, useState } from \"react\";\nimport { Row, Col, Typography, Button, Checkbox } from \"antd\";\nimport styled from 'styled-components'\nimport { Link } from 'react-router-dom'\nimport ReactMarkdown from 'react-markdown'\nimport { useMutation } from \"@apollo/client\";\nimport { AgreeTerms, AgreeTermsArgs, AgreeTermsRes } from \"graphql-src/users/mutations\";\nimport { useOnboarding } from 'layouts/onboarding-layout/onboarding-context'\nimport { useStoreState } from \"state\";\n\nconst { Title } = Typography\n\nconst Content = styled.div`\n  height: calc(100% - 80px);\n`\nconst Terms = styled.div`\n  overflow: auto;\n`\n\ninterface Props {\n  match: any;\n  history: any;\n}\n\nexport const TermConditions = (props: Props) => {\n  const [agree, setAgree] = useState(false)\n  const { state } = useOnboarding()\n  const id = useStoreState(state => state.user.id)\n  const onboarded = useStoreState(state => state.user.onboarded)\n  const [agreeTerms] = useMutation<AgreeTermsRes, AgreeTermsArgs>(AgreeTerms)\n\n  useEffect(() => {\n    if (onboarded)\n      props.history.push('/onboarding/dealer/business-details')\n  }, [onboarded])\n\n  const handleSubmit = () => {\n    if (state.userTerms) {\n      agreeTerms({\n        variables: {\n          id,\n          termsAgreement: {\n            create: {\n              terms: {\n                connect: {\n                  id: state.userTerms.id!\n                }\n              }\n            }\n          }\n        },\n        optimisticResponse: {\n          user: {\n            id,\n            termsAgreement: {\n              expired: false,\n              id: '0'\n            }\n          }\n        }\n      })\n      props.history.push('business-details')\n    }\n  }\n\n  return (\n    <Content>\n      <Title level={3}>Hytalk User Terms &amp; Conditions</Title>\n      <Terms>\n        <ReactMarkdown children={state.userTerms ? state.userTerms.content : ''} />\n        <Row justify=\"end\" className=\"mt-4\">\n          <Col>\n            <Checkbox disabled={!state.userTerms} value={agree} onChange={() => setAgree(!agree)}>I agree to the terms and conditions</Checkbox>\n          </Col>\n        </Row>\n        <Row justify=\"end\" className=\"mt-2 pb-5\">\n          <Col>\n            <Button disabled={!agree} type=\"primary\" onClick={handleSubmit}>Next</Button>\n          </Col>\n        </Row>\n      </Terms>\n      \n    </Content>\n  );\n};","/Users/willgarrod/Projects/hytalk-manage/src/views/onboarding-views/dealer/views/terms-of-business.tsx",["3374","3375","3376","3377","3378","3379","3380"],"import React, { useState, useRef, useEffect } from \"react\";\nimport { Row, Col, Typography, Button, Form, Input } from \"antd\";\nimport styled from \"styled-components\";\nimport { useMutation } from \"@apollo/client\";\nimport Signature from \"react-signature-canvas\";\nimport { useOnboarding } from 'layouts/onboarding-layout/onboarding-context'\nimport ReactMarkdown from 'react-markdown'\nimport { SignTerms, SignTermsArgs, SignTermsRes } from \"graphql-src/organisations/mutations\";\n\nconst { Paragraph, Title } = Typography;\n\nconst Content = styled.div`\n  height: calc(100% - 80px);\n`;\nconst Terms = styled.div`\n  overflow: auto;\n`;\n\ntype ReactSignatureCanvas = Signature\n\ninterface SignatureInputProps {\n  value?: any;\n  onChange?: (value: any) => void;\n}\n\nconst SignatureInput = ({ onChange, value }: SignatureInputProps) => {\n  const signatureRef = useRef<ReactSignatureCanvas | null>(null)\n\n  const onClear = () => {\n    signatureRef?.current?.clear()\n  }\n\n  const handleChange = () => {\n    onChange && onChange(signatureRef?.current?.toDataURL()!)\n  }\n\n  return (\n    <div>\n      <Signature\n        ref={signatureRef}\n        canvasProps={{\n          width: 400,\n          height: 120,\n          className: \"sigCanvas\",\n          style: {\n            border: \"1px #adadad solid\",\n            borderRadius: 10\n          },\n        }}\n        onEnd={handleChange}\n      />\n      <Button size=\"small\" onClick={onClear}>Clear</Button>\n    </div>\n    \n  );\n};\n\ninterface Props {\n  match: any;\n  history: any;\n}\n\nexport const TermsOfBusiness = (props: Props) => {\n  const { state } = useOnboarding()\n\n  const onSubmit = () => {\n    props.history.push('/onboarding/dealer/payment-method/processing')\n  }\n\n  return (\n    <Content>\n      <Title level={3}>Terms of Business</Title>\n      <Terms>\n        <ReactMarkdown children={state.businessTerms ? state.businessTerms.content : ''} />\n        <Form layout=\"vertical\" onFinish={onSubmit}>\n          <Row className=\"mt-5\">\n            <Col span=\"6\" />\n            <Col span=\"10\">\n              <Form.Item\n                label=\"Signature\"\n                name=\"signature\"\n                rules={[\n                  {\n                    required: true,\n                    message: \"Please sign the terms of business\",\n                  },\n                ]}\n              >\n                <SignatureInput />\n              </Form.Item>\n            </Col>\n            <Col span=\"8\">\n              <Form.Item\n                label=\"Full Name\"\n                name=\"name\"\n                rules={[\n                  { required: true, message: \"Please complete this field.\" },\n                ]}\n              >\n                <Input />\n              </Form.Item>\n              <Form.Item\n                label=\"Job Title\"\n                name=\"jobTitle\"\n                rules={[\n                  { required: true, message: \"Please complete this field.\" },\n                ]}\n              >\n                <Input />\n              </Form.Item>\n            </Col>\n          </Row>\n          <Form.Item>\n            <Row justify=\"end\">\n              <Button type=\"primary\" htmlType=\"submit\">\n                Agree to Terms\n              </Button>\n            </Row>\n          </Form.Item>\n        </Form>\n      </Terms>\n    </Content>\n  );\n};\n","/Users/willgarrod/Projects/hytalk-manage/src/layouts/onboarding-layout/onboarding-context.tsx",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/terms/queries/terms-with-content.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/users/mutations/agree-terms.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/organisations/mutations/update-business-details.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/organisations/queries/business-details.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/organisations/enums/onboarding-step.ts",[],"/Users/willgarrod/Projects/hytalk-manage/src/graphql-src/organisations/mutations/sign-terms.ts",[],"/Users/willgarrod/Projects/signup-web/src/index.tsx",[],["3381","3382"],"/Users/willgarrod/Projects/signup-web/src/serviceWorker.js",[],["3383","3384"],"/Users/willgarrod/Projects/signup-web/src/App.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/router.tsx",[],"/Users/willgarrod/Projects/signup-web/src/state/index.ts",[],"/Users/willgarrod/Projects/signup-web/src/state/theme-model.ts",[],"/Users/willgarrod/Projects/signup-web/src/state/store.tsx",[],"/Users/willgarrod/Projects/signup-web/src/configs/AppConfig.ts",[],"/Users/willgarrod/Projects/signup-web/src/hooks/useAuth.ts",[],"/Users/willgarrod/Projects/signup-web/src/views/auth-views/authentication/loading/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/state/data-model.ts",[],"/Users/willgarrod/Projects/signup-web/src/lang/index.ts",[],"/Users/willgarrod/Projects/signup-web/src/state/user-model.ts",[],"/Users/willgarrod/Projects/signup-web/src/state/auth-model.ts",[],"/Users/willgarrod/Projects/signup-web/src/configs/EnvironmentConfig.ts",[],"/Users/willgarrod/Projects/signup-web/src/layouts/auth-layout/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/layouts/app-layout/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/lang/entries/en_US.ts",[],"/Users/willgarrod/Projects/signup-web/src/lang/entries/fr_FR.ts",[],"/Users/willgarrod/Projects/signup-web/src/configs/NavigationConfig.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/auth/queries/index.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/auth/mutations/index.ts",[],"/Users/willgarrod/Projects/signup-web/src/constants/ThemeConstant.ts",[],"/Users/willgarrod/Projects/signup-web/src/views/app-views/router.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/layout-components/Footer.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/layout-components/navigation/MobileNav.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/layout-components/navigation/HeaderNav.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/shared-components/Loading/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/utils/index.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/auth/mutations/sign-in.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/auth/mutations/verify-user.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/auth/queries/verify.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/auth/queries/current-user.ts",[],"/Users/willgarrod/Projects/signup-web/src/components/layout-components/navigation/Logo.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/layout-components/navigation/NavProfile.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/layout-components/navigation/MenuContent.tsx",[],"/Users/willgarrod/Projects/signup-web/src/types/index.ts",[],["3385","3386"],"/Users/willgarrod/Projects/signup-web/src/components/shared-components/Flex/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/util-components/IntlMessage/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/util-components/Icon/index.js",[],"/Users/willgarrod/Projects/signup-web/src/components/layout-components/index.ts",[],"/Users/willgarrod/Projects/signup-web/src/layouts/inner-app-layout/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/types/enums/index.ts",[],"/Users/willgarrod/Projects/signup-web/src/components/layout-components/PageHeader.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/layout-components/grow.tsx",[],"/Users/willgarrod/Projects/signup-web/src/types/enums/account-types.ts",[],"/Users/willgarrod/Projects/signup-web/src/types/enums/roles.ts",[],"/Users/willgarrod/Projects/signup-web/src/components/layout-components/navigation/index.ts",[],"/Users/willgarrod/Projects/signup-web/src/components/layout-components/navigation/SideMenu.tsx",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/staff/queries/index.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/staff/mutations/index.ts",[],"/Users/willgarrod/Projects/signup-web/src/components/shared-components/EditableCell/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/staff/mutations/invite-staff.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/staff/queries/staff-members.ts",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/form-drawer/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/form-drawer/form-drawer.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/layout-components/navigation/TopNav.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/layout-components/navigation/SideNav.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/auth-views/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/auth-views/authentication/verify/index.ts",[],"/Users/willgarrod/Projects/signup-web/src/views/auth-views/authentication/login-2/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/auth-views/authentication/register-2/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/auth-views/authentication/login-1/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/auth-views/authentication/login/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/auth-views/authentication/register-1/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/auth-views/authentication/forgot-password/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/auth-views/errors/error-page-1/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/auth-views/errors/error-page-2/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/auth-views/authentication/verify/verify.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/auth-views/components/LoginForm.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/auth-views/components/RegisterForm.tsx",[],"/Users/willgarrod/Projects/signup-web/src/assets/svg/icon.js",[],"/Users/willgarrod/Projects/signup-web/src/components/util-components/CustomIcon/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/app-views/admin-views/settings/router.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/app-views/admin-views/settings/devices/router.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/app-views/admin-views/settings/items/router.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/app-views/admin-views/settings/platforms/router.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/app-views/admin-views/settings/platforms/platforms-list.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/app-views/admin-views/settings/devices/devices-list.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/app-views/admin-views/settings/items/items-list.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/app-views/admin-views/schemes/router.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/app-views/admin-views/agreements/router.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/app-views/admin-views/agreements/agreements-list.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/app-views/admin-views/schemes/schemes-list.tsx",["3387"],"/Users/willgarrod/Projects/signup-web/src/graphql-src/schemes/queries/index.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/schemes/queries/schemes.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/devices/queries/index.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/devices/queries/devices.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/items/queries/index.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/items/queries/items.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/platforms/queries/index.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/platforms/queries/platforms.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/platforms/queries/platform.ts",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/platforms/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/platforms/edit/edit-platform-form.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/platforms/platform-form.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/platforms/add/add-platform-drawer.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/platforms/edit/edit-platform-drawer.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/platforms/add/add-platform-form.tsx",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/platforms/mutations/index.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/platforms/mutations/update-platform.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/platforms/mutations/create-platform.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/devices/queries/manufacturers.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/items/queries/item.ts",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/devices/queries/device.ts",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/form/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/form/standard-form.tsx",["3388"],"import React, { useRef, useEffect } from \"react\";\nimport {\n  Form,\n  Button,\n  FormInstance,\n  Row,\n  FormItemProps,\n  Checkbox\n} from \"antd\";\nimport { Grow } from \"components/layout-components\";\n\ninterface Field extends FormItemProps {\n  render(props: { disabled: boolean; }): JSX.Element;\n  checkbox?: boolean;\n}\n\ninterface Props<T> {\n  onClose(): void;\n  onSubmit(data: T): void;\n  loading?: boolean;\n  saving: boolean;\n  data?: T;\n  initialValues: T;\n  fields: Field[]\n}\n\nexport const StandardForm = <T,>({\n  onClose,\n  onSubmit,\n  loading,\n  saving,\n  data,\n  initialValues,\n  fields\n}: Props<T>) => {\n  const formRef = useRef<FormInstance<T>>(null);\n\n  const tailLayout = {\n    wrapperCol: { span: 22 },\n  };\n\n  useEffect(() => {\n    if (data) {\n      // @ts-expect-error type does not like other type\n      formRef.current?.setFieldsValue(data);\n    }\n  }, [data]);\n\n  const handleClose = () => {\n    formRef.current?.resetFields();\n    onClose();\n  };\n\n  const handleSubmit = async (data: T) => {\n    onSubmit(data);\n  };\n\n  return (\n    <Form\n      name=\"basic\"\n      onFinish={handleSubmit}\n      onFinishFailed={() => {}}\n      ref={formRef}\n      style={{ display: \"flex\", flexDirection: \"column\", flex: 1 }}\n      initialValues={initialValues}\n      layout=\"vertical\"\n    >\n      {fields.map(({ render, name, label, rules, checkbox }) => (\n        <Form.Item\n          label={label}\n          name={name}\n          rules={rules}\n          valuePropName={checkbox ? 'checked' : undefined}\n        >\n          {render({ disabled: loading || saving })}\n        </Form.Item>\n      ))}\n\n      <Grow />\n\n      <Form.Item {...tailLayout}>\n        <Row justify=\"end\">\n          <Button\n            type=\"ghost\"\n            onClick={handleClose}\n            style={{ marginRight: 15 }}\n            disabled={loading || saving}\n          >\n            Cancel\n          </Button>\n          <Button\n            type=\"primary\"\n            htmlType=\"submit\"\n            loading={saving}\n            disabled={loading}\n          >\n            Submit\n          </Button>\n        </Row>\n      </Form.Item>\n    </Form>\n  );\n};\n","/Users/willgarrod/Projects/signup-web/src/components/form-components/items/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/items/edit/edit-item-drawer.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/items/item-form.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/items/add/add-item-drawer.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/items/add/add-item-form.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/items/edit/edit-item-form.tsx",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/items/mutations/index.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/items/mutations/create-item.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/items/mutations/update-item.ts",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/devices/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/devices/device-form.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/devices/edit/edit-device-drawer.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/devices/add/add-device-form.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/devices/edit/edit-device-form.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/devices/add/add-device-drawer.tsx",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/devices/mutations/index.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/devices/mutations/create-device.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/devices/mutations/update-device.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/staff/queries/existing-staff.ts",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/staff/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/staff/staff-form.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/staff/edit/edit-staff-drawer.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/staff/edit/edit-staff-form.tsx",["3389"],"import React from \"react\";\nimport { useMutation, MutationUpdaterFn, useQuery } from \"@apollo/client\";\nimport { notification } from \"antd\";\nimport {\n  UpdatePlatform,\n  UpdatePlatformArg,\n  UpdatePlatformRes,\n} from \"graphql-src/platforms/mutations\";\nimport { Platform, PlatformRes, PlatformArgs } from \"graphql-src/platforms/queries\";\nimport { StaffForm, StaffFormData } from \"../staff-form\";\n\ninterface Props {\n  onClose(): void;\n  update?: MutationUpdaterFn<UpdatePlatformRes>;\n  onSuccess?(): void;\n  onError?(): void;\n  id: string;\n}\n\nexport const EditPlatformForm = ({\n  onClose,\n  update,\n  onError,\n  onSuccess,\n  id,\n}: Props) => {\n  const [updatePlatform, { loading }] = useMutation<\n    UpdatePlatformRes,\n    UpdatePlatformArg\n  >(UpdatePlatform, {\n    update,\n    onCompleted: onSuccess,\n    onError,\n  });\n\n  const { data, loading: productLoading } = useQuery<PlatformRes, PlatformArgs>(\n    Platform,\n    {\n      variables: {\n        where: { id }\n      },\n      onError: () => {\n        notification['error']({\n          message: 'An error has occurred',\n          description:\n            'This error has been reported to our development team. If this persists please contact our support team.',\n          placement: 'bottomRight'\n        });\n      }\n    }\n  );\n\n  const handleSubmit = async ({\n    name,\n    email,\n    role\n  }: StaffFormData) => {\n    // await updatePlatform({\n    //   variables: {\n    //     where: {\n    //       id,\n    //     },\n    //     data: {\n    //       name: { set: name },\n    //       description: { set: description },\n    //     }\n    //   },\n    // });\n  };\n\n  return (\n    <StaffForm\n      saving={loading}\n      loading={productLoading}\n      data={\n        data\n          ? {\n              email: '',\n              role: 'ADMIN',\n              name: data.platform.name,\n            }\n          : undefined\n      }\n      onClose={onClose}\n      onSubmit={handleSubmit}\n    />\n  );\n};\n","/Users/willgarrod/Projects/signup-web/src/components/form-components/staff/add/add-staff-drawer.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/staff/add/add-staff-form.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/staff/add/existing-staff.tsx",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/staff/mutations/invite-existing-staff.ts",[],"/Users/willgarrod/Projects/signup-web/src/views/app-views/admin-views/settings/staff/router.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/app-views/admin-views/settings/staff/staff-list.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/app-views/admin-views/schemes/view-scheme.tsx",["3390"],"/Users/willgarrod/Projects/signup-web/src/graphql-src/schemes/queries/scheme.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/index.tsx",[],["3391","3392"],"/Users/willgarrod/Projects/alert-web-2.0/src/serviceWorker.js",[],["3393","3394"],"/Users/willgarrod/Projects/alert-web-2.0/src/App.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/views/router.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/state/index.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/state/theme-model.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/state/store.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/configs/AppConfig.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/hooks/useAuth.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/views/auth-views/authentication/loading/index.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/state/data-model.ts",[],["3395","3396"],"/Users/willgarrod/Projects/alert-web-2.0/src/lang/index.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/state/user-model.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/state/auth-model.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/configs/EnvironmentConfig.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/layouts/auth-layout/index.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/layouts/app-layout/index.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/lang/entries/fr_FR.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/lang/entries/en_US.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/configs/NavigationConfig.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/graphql-src/auth/mutations/index.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/graphql-src/auth/queries/index.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/constants/ThemeConstant.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/views/app-views/router.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/components/layout-components/navigation/HeaderNav.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/components/layout-components/Footer.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/components/layout-components/navigation/MobileNav.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/components/shared-components/Loading/index.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/utils/index.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/graphql-src/auth/queries/current-user.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/graphql-src/auth/mutations/sign-in.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/graphql-src/auth/queries/verify.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/graphql-src/auth/mutations/verify-user.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/components/layout-components/navigation/Logo.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/components/layout-components/navigation/MenuContent.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/components/layout-components/navigation/NavProfile.tsx",["3397"],"import React from \"react\";\r\nimport { Menu, Dropdown, Avatar, Row } from \"antd\";\r\nimport { \r\n  LogoutOutlined \r\n} from '@ant-design/icons';\r\nimport Icon from 'components/util-components/Icon';\r\nimport { useStoreState } from 'state'\r\nimport useAuth from 'hooks/useAuth'\r\n\r\ninterface MenuItem {\r\n  title: string;\r\n  icon: string;\r\n  path: string;\r\n}\r\n\r\nconst menuItem: MenuItem[] = [\r\n  // {\r\n  //   title: \"Edit Profile\",\r\n  //   icon: EditOutlined ,\r\n  //   path: \"/\"\r\n  //   },\r\n    \r\n  //   {\r\n  //   title: \"Account Setting\",\r\n  //   icon: SettingOutlined,\r\n  //   path: \"/\"\r\n  //   },\r\n  //   {\r\n  //   title: \"Billing\",\r\n  //   icon: ShopOutlined ,\r\n  //   path: \"/\"\r\n  // },\r\n  //   {\r\n  //   title: \"Help Center\",\r\n  //   icon: QuestionCircleOutlined,\r\n  //   path: \"/\"\r\n  // }\r\n]\r\n\r\nexport const NavProfile = () => {\r\n  const name = useStoreState(state => state.user.fullName)\r\n  const email = useStoreState(state => state.user.email)\r\n  const profileImg = useStoreState(state => state.user.picture)\r\n  const { signOut } = useAuth()\r\n\r\n  const profileMenu = (\r\n    <div className=\"nav-profile nav-dropdown\">\r\n      <div className=\"nav-profile-header\">\r\n        <div className=\"d-flex\" style={{ alignItems: 'center' }}>\r\n          <Avatar style={{ backgroundColor: 'rgb(222, 68, 54)', minWidth: 35 }} size={35}>{name.charAt(0)}</Avatar>\r\n          <div className=\"pl-2\">\r\n            <h4 className=\"mb-0\">{name}</h4>\r\n            <span className=\"text-muted\">{email}</span>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <div className=\"nav-profile-body\">\r\n        <Menu>\r\n          {menuItem.map((el, i) => {\r\n            return (\r\n              <Menu.Item key={i}>\r\n                <a href={el.path}>\r\n                  <Row>\r\n                    <Icon className=\"mr-3\" type={el.icon} />\r\n                    <span className=\"font-weight-normal\">{el.title}</span>\r\n                  </Row>\r\n                </a>\r\n              </Menu.Item>\r\n            );\r\n          })}\r\n          <Menu.Item key={menuItem.length + 1} onClick={e => signOut()}>\r\n            <Row>\r\n              <LogoutOutlined className=\"mr-3\"/>\r\n              <span className=\"font-weight-normal\">Sign Out</span>\r\n            </Row>\r\n          </Menu.Item>\r\n        </Menu>\r\n      </div>\r\n    </div>\r\n  );\r\n  return (\r\n    <Dropdown placement=\"bottomRight\" overlay={profileMenu} trigger={[\"click\"]}>\r\n      <Menu className=\"d-flex align-item-center\" mode=\"horizontal\">\r\n        <Menu.Item>\r\n          <Avatar style={{ backgroundColor: 'rgb(222, 68, 54)' }}>{name.charAt(0)}</Avatar>\r\n        </Menu.Item>\r\n      </Menu>\r\n    </Dropdown>\r\n  );\r\n}\r\n\r\nexport default NavProfile;\r\n","/Users/willgarrod/Projects/alert-web-2.0/src/views/app-views/admin-views/scheme/router.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/views/app-views/admin-views/user/router.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/components/shared-components/Flex/index.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/components/util-components/IntlMessage/index.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/components/util-components/Icon/index.js",[],"/Users/willgarrod/Projects/alert-web-2.0/src/components/layout-components/navigation/TopNav.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/components/layout-components/navigation/SideNav.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/views/auth-views/index.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/views/auth-views/authentication/verify/index.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/views/auth-views/errors/error-page-2/index.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/views/auth-views/errors/error-page-1/index.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/views/auth-views/authentication/register-2/index.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/views/auth-views/authentication/forgot-password/index.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/views/auth-views/authentication/register-1/index.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/views/auth-views/authentication/login-2/index.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/views/auth-views/authentication/login-1/index.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/views/auth-views/authentication/login/index.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/views/auth-views/authentication/verify/verify.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/views/auth-views/components/RegisterForm.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/views/auth-views/components/LoginForm.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/assets/svg/icon.js",[],"/Users/willgarrod/Projects/alert-web-2.0/src/components/util-components/CustomIcon/index.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/state/scheme-model.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/graphql-src/users/enums/index.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/graphql-src/users/enums/role.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/incidents/feed/AlertFeedQuery/AlertFeedQuery.jsx",["3398","3399"],"import React, { useState, useEffect } from 'react';\nimport { useQuery, useMutation } from '@apollo/client';\n\nimport { IncidentFeed } from 'graphql-src/incidents/queries';\nimport AlertFeed from '../AlertFeed/AlertFeed';\nimport {\n  AddIncidentToGroup,\n  ApproveIncident,\n  RemoveIncident\n} from 'graphql-src/incidents/mutations';\nimport { AddOffenderToGroup, ApproveOffender } from 'graphql-src/offenders/mutations';\nimport Offline from '../../../global/Offline/Offline';\nimport { useStoreActions, useStoreState } from '../../../../state';\n\nconst AlertFeedQuery = () => {\n  const setBottomNav = useStoreActions(actions => actions.theme.setBottomNav);\n  const setAppBar = useStoreActions(actions => actions.theme.setAppBar);\n  const setTitle = useStoreActions(\n    actions => actions.theme.setTitle\n  );\n  const setStatusBar = useStoreActions(actions => actions.theme.setStatusBar);\n  const setSearch = useStoreActions(actions => actions.theme.setBottomNav);\n  const setSearchText = useStoreActions(actions => actions.theme.setBottomNav);\n  const toggleFetchIncidents = useStoreActions(\n    actions => actions.theme.setBottomNav\n  );\n  const scheme = useStoreState(state => state.scheme.id);\n  const role = useStoreState(state => state.user.role);\n  const userId = useStoreState(state => state.user.id);\n  const search = useStoreState(state => state.theme.search);\n  const fetchIncidents = useStoreState(state => state.theme.fetchIncidents);\n  const admin = role === 'USER' ? true : false;\n\n  const [order, setOrder] = useState('desc')\n  const [allLoaded, setAllLoaded] = useState(false)\n  const [fetching, setFetching] = useState(false)\n  const [networkError, setNetworkError] = useState('')\n  const [crimeTypes, setCrimeTypes] = useState([])\n  const [filterSet, setFilterSet] = useState(false)\n  \n  useEffect(() => {\n    setBottomNav(true);\n    setTitle('Incidents');\n    setAppBar(true);\n    setSearch(true);\n    setSearchText('Search for incidents...');\n    return () => {\n      setSearch(false);\n      setSearchText('');\n      toggleFetchIncidents(true);\n    }\n  }, [])\n\n  useEffect(() => {\n    if (allLoaded)\n      setAllLoaded(false)\n  }, [search])\n\n\n  const changeOrder = order => {\n    setOrder(order)\n    setAllLoaded(false)\n\n  }\n\n  const changeCrimeTypes = crimeTypes => {\n    setCrimeTypes(crimeTypes)\n    setFilterSet(true)\n    setAllLoaded(false)\n  };\n\n  // Set queries based on users role\n  let querySize = 10;\n  if (window.innerWidth > 1239 && window.innerWidth < 1800) {\n    querySize = 12;\n  } else if (window.innerWidth > 1799) {\n    querySize = 16;\n  }\n\n  const variables = {\n    userId,\n    schemeId: scheme,\n    search,\n    order: { createdAt: order },\n    first: querySize,\n    crimeTypes: crimeTypes.length > 0 ? crimeTypes : undefined\n  };\n\n  const { data, loading, fetchMore, refetch, error } = useQuery(IncidentFeed, {\n    variables,\n    fetchPolicy: 'cache-and-network'\n  })\n  const [addIncidentToGroup] = useMutation(AddIncidentToGroup)\n  const [approveIncident] = useMutation(ApproveIncident)\n  const [addOffenderToGroup] = useMutation(AddOffenderToGroup)\n  const [approveOffender] = useMutation(ApproveOffender)\n  const [deleteIncident] = useMutation(RemoveIncident, {\n    update: async (store, { data: { deleteIncident } }) => {\n      const response = store.readQuery({\n        query: IncidentFeed,\n        variables: {\n          cursor,\n          ...variables,\n          first: 1\n        }\n      });\n\n      const data = store.readQuery({\n        query: IncidentFeed,\n        variables\n      });\n      data.incidentFeed = data.incidentFeed.filter(\n        alert => alert.id !== deleteIncident.id\n      );\n      if (response.incidentFeed.length > 0) {\n        data.incidentFeed.push(\n          response.incidentFeed[0]\n        );\n      }\n      store.writeQuery({\n        query: IncidentFeed,\n        data,\n        variables\n      });\n    }\n  })\n\n  let cursor;\n  if (\n    loading &&\n    !!data &&\n    !!data.incidentFeed &&\n    data.incidentFeed.length > 0\n  ) {\n    cursor = data.incidentFeed.slice(-1)[0].id;\n  }\n\n  const loadMore = async () => {\n    if (!allLoaded && !fetching) {\n      // Set fetching state\n      setFetching(true)\n      // Do not fetch more if currently fetching or all records have been fetched\n      await fetchMore({\n          query: IncidentFeed,\n          variables: {\n            cursor,\n            ...variables\n          },\n          updateQuery: (previousResult, { fetchMoreResult }) => {\n            let newAlerts = [];\n            fetchMoreResult.incidentFeed.length === 1 &&\n              fetchMoreResult.incidentFeed[0].id === cursor &&\n              setAllLoaded(true)\n\n            fetchMoreResult.incidentFeed.forEach(alert => {\n              !previousResult.incidentFeed\n                .map(({ id }) => id)\n                .includes(alert.id) && newAlerts.push(alert);\n            });\n\n            return {\n              incidentFeed: [\n                ...previousResult.incidentFeed,\n                ...newAlerts\n              ]\n            };\n          }\n        })\n        .then(() => {\n          setFetching(false)\n        })\n        .catch(error => {\n          setFetching(false)\n          if (error.networkError !== undefined) {\n            setNetworkError(true)\n          }\n        });\n    }\n  };\n\n  const retryLoad = () => {\n    setNetworkError(false)\n    loadMore();\n  };\n\n  return error !== undefined && error.networkError !== undefined ? (\n    <Offline type=\"incidents\" />\n  ) : (\n    <AlertFeed\n      loading={loading}\n      alerts={\n        !!data\n          ? data.incidentFeed\n          : []\n      }\n      refetch={refetch}\n      setOrder={changeOrder}\n      search={search}\n      loadMore={loadMore}\n      addIncidentToGroup={addIncidentToGroup}\n      approveIncident={approveIncident}\n      setStatusBar={setStatusBar}\n      addOffenderToGroup={addOffenderToGroup}\n      approveOffender={approveOffender}\n      deleteIncident={deleteIncident}\n      admin={admin}\n      userId={userId}\n      loadingMore={fetching}\n      networkError={networkError}\n      retryLoad={retryLoad}\n      fetchIncidents={fetchIncidents}\n      toggleFetchIncidents={\n        toggleFetchIncidents\n      }\n      order={order}\n      crimeTypes={crimeTypes}\n      setCrimeTypes={changeCrimeTypes}\n      filterSet={filterSet}\n    />\n  )\n}\n\nexport default AlertFeedQuery;\n","/Users/willgarrod/Projects/alert-web-2.0/src/old-components/incidents/feed/AlertFeed/AlertFeed.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/global/Offline/Offline.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/incidents/feed/SkeletonAlertCard/SkeletonAlertCard.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/incidents/feed/AlertFilter/AlertFilter.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/incidents/feed/AlertCard/AlertCard.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/incidents/feed/OffenderPopOver/OffenderPopOver.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/incidents/feed/DeclineDialog/DeclineDialog.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/global/cards/UnapprovedCardGroups/UnapprovedCardGroups.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/global/cards/index.js",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/global/emptyStates/index.js",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/global/pullToRefresh/index.js",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/global/feed/index.js",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/incidents/feed/AlertCardLocation/AlertCardLocation.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/incidents/feed/AlertCardDescription/AlertCardDescription.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/incidents/feed/AlertCardImages/AlertCardImages.jsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-compone