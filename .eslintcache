ions/index.ts",[],"/Users/willgarrod/Projects/signup-web/src/constants/ThemeConstant.ts",[],"/Users/willgarrod/Projects/signup-web/src/views/app-views/router.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/layout-components/Footer.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/layout-components/navigation/MobileNav.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/layout-components/navigation/HeaderNav.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/shared-components/Loading/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/utils/index.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/auth/mutations/sign-in.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/auth/mutations/verify-user.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/auth/queries/verify.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/auth/queries/current-user.ts",[],"/Users/willgarrod/Projects/signup-web/src/components/layout-components/navigation/Logo.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/layout-components/navigation/NavProfile.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/layout-components/navigation/MenuContent.tsx",[],"/Users/willgarrod/Projects/signup-web/src/types/index.ts",[],["3499","3500"],"/Users/willgarrod/Projects/signup-web/src/components/shared-components/Flex/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/util-components/IntlMessage/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/util-components/Icon/index.js",[],"/Users/willgarrod/Projects/signup-web/src/components/layout-components/index.ts",[],"/Users/willgarrod/Projects/signup-web/src/layouts/inner-app-layout/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/types/enums/index.ts",[],"/Users/willgarrod/Projects/signup-web/src/components/layout-components/PageHeader.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/layout-components/grow.tsx",[],"/Users/willgarrod/Projects/signup-web/src/types/enums/account-types.ts",[],"/Users/willgarrod/Projects/signup-web/src/types/enums/roles.ts",[],"/Users/willgarrod/Projects/signup-web/src/components/layout-components/navigation/index.ts",[],"/Users/willgarrod/Projects/signup-web/src/components/layout-components/navigation/SideMenu.tsx",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/staff/queries/index.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/staff/mutations/index.ts",[],"/Users/willgarrod/Projects/signup-web/src/components/shared-components/EditableCell/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/staff/mutations/invite-staff.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/staff/queries/staff-members.ts",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/form-drawer/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/form-drawer/form-drawer.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/layout-components/navigation/TopNav.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/layout-components/navigation/SideNav.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/auth-views/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/auth-views/authentication/verify/index.ts",[],"/Users/willgarrod/Projects/signup-web/src/views/auth-views/authentication/login-2/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/auth-views/authentication/register-2/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/auth-views/authentication/login-1/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/auth-views/authentication/login/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/auth-views/authentication/register-1/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/auth-views/authentication/forgot-password/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/auth-views/errors/error-page-1/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/auth-views/errors/error-page-2/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/auth-views/authentication/verify/verify.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/auth-views/components/LoginForm.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/auth-views/components/RegisterForm.tsx",[],"/Users/willgarrod/Projects/signup-web/src/assets/svg/icon.js",[],"/Users/willgarrod/Projects/signup-web/src/components/util-components/CustomIcon/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/app-views/admin-views/settings/router.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/app-views/admin-views/settings/devices/router.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/app-views/admin-views/settings/items/router.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/app-views/admin-views/settings/platforms/router.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/app-views/admin-views/settings/platforms/platforms-list.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/app-views/admin-views/settings/devices/devices-list.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/app-views/admin-views/settings/items/items-list.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/app-views/admin-views/schemes/router.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/app-views/admin-views/agreements/router.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/app-views/admin-views/agreements/agreements-list.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/app-views/admin-views/schemes/schemes-list.tsx",["3501"],"/Users/willgarrod/Projects/signup-web/src/graphql-src/schemes/queries/index.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/schemes/queries/schemes.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/devices/queries/index.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/devices/queries/devices.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/items/queries/index.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/items/queries/items.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/platforms/queries/index.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/platforms/queries/platforms.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/platforms/queries/platform.ts",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/platforms/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/platforms/edit/edit-platform-form.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/platforms/platform-form.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/platforms/add/add-platform-drawer.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/platforms/edit/edit-platform-drawer.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/platforms/add/add-platform-form.tsx",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/platforms/mutations/index.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/platforms/mutations/update-platform.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/platforms/mutations/create-platform.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/devices/queries/manufacturers.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/items/queries/item.ts",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/devices/queries/device.ts",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/form/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/form/standard-form.tsx",["3502"],"import React, { useRef, useEffect } from \"react\";\nimport {\n  Form,\n  Button,\n  FormInstance,\n  Row,\n  FormItemProps,\n  Checkbox\n} from \"antd\";\nimport { Grow } from \"components/layout-components\";\n\ninterface Field extends FormItemProps {\n  render(props: { disabled: boolean; }): JSX.Element;\n  checkbox?: boolean;\n}\n\ninterface Props<T> {\n  onClose(): void;\n  onSubmit(data: T): void;\n  loading?: boolean;\n  saving: boolean;\n  data?: T;\n  initialValues: T;\n  fields: Field[]\n}\n\nexport const StandardForm = <T,>({\n  onClose,\n  onSubmit,\n  loading,\n  saving,\n  data,\n  initialValues,\n  fields\n}: Props<T>) => {\n  const formRef = useRef<FormInstance<T>>(null);\n\n  const tailLayout = {\n    wrapperCol: { span: 22 },\n  };\n\n  useEffect(() => {\n    if (data) {\n      // @ts-expect-error type does not like other type\n      formRef.current?.setFieldsValue(data);\n    }\n  }, [data]);\n\n  const handleClose = () => {\n    formRef.current?.resetFields();\n    onClose();\n  };\n\n  const handleSubmit = async (data: T) => {\n    onSubmit(data);\n  };\n\n  return (\n    <Form\n      name=\"basic\"\n      onFinish={handleSubmit}\n      onFinishFailed={() => {}}\n      ref={formRef}\n      style={{ display: \"flex\", flexDirection: \"column\", flex: 1 }}\n      initialValues={initialValues}\n      layout=\"vertical\"\n    >\n      {fields.map(({ render, name, label, rules, checkbox }) => (\n        <Form.Item\n          label={label}\n          name={name}\n          rules={rules}\n          valuePropName={checkbox ? 'checked' : undefined}\n        >\n          {render({ disabled: loading || saving })}\n        </Form.Item>\n      ))}\n\n      <Grow />\n\n      <Form.Item {...tailLayout}>\n        <Row justify=\"end\">\n          <Button\n            type=\"ghost\"\n            onClick={handleClose}\n            style={{ marginRight: 15 }}\n            disabled={loading || saving}\n          >\n            Cancel\n          </Button>\n          <Button\n            type=\"primary\"\n            htmlType=\"submit\"\n            loading={saving}\n            disabled={loading}\n          >\n            Submit\n          </Button>\n        </Row>\n      </Form.Item>\n    </Form>\n  );\n};\n","/Users/willgarrod/Projects/signup-web/src/components/form-components/items/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/items/edit/edit-item-drawer.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/items/item-form.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/items/add/add-item-drawer.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/items/add/add-item-form.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/items/edit/edit-item-form.tsx",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/items/mutations/index.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/items/mutations/create-item.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/items/mutations/update-item.ts",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/devices/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/devices/device-form.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/devices/edit/edit-device-drawer.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/devices/add/add-device-form.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/devices/edit/edit-device-form.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/devices/add/add-device-drawer.tsx",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/devices/mutations/index.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/devices/mutations/create-device.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/devices/mutations/update-device.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/staff/queries/existing-staff.ts",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/staff/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/staff/staff-form.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/staff/edit/edit-staff-drawer.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/staff/edit/edit-staff-form.tsx",["3503"],"import React from \"react\";\nimport { useMutation, MutationUpdaterFn, useQuery } from \"@apollo/client\";\nimport { notification } from \"antd\";\nimport {\n  UpdatePlatform,\n  UpdatePlatformArg,\n  UpdatePlatformRes,\n} from \"graphql-src/platforms/mutations\";\nimport { Platform, PlatformRes, PlatformArgs } from \"graphql-src/platforms/queries\";\nimport { StaffForm, StaffFormData } from \"../staff-form\";\n\ninterface Props {\n  onClose(): void;\n  update?: MutationUpdaterFn<UpdatePlatformRes>;\n  onSuccess?(): void;\n  onError?(): void;\n  id: string;\n}\n\nexport const EditPlatformForm = ({\n  onClose,\n  update,\n  onError,\n  onSuccess,\n  id,\n}: Props) => {\n  const [updatePlatform, { loading }] = useMutation<\n    UpdatePlatformRes,\n    UpdatePlatformArg\n  >(UpdatePlatform, {\n    update,\n    onCompleted: onSuccess,\n    onError,\n  });\n\n  const { data, loading: productLoading } = useQuery<PlatformRes, PlatformArgs>(\n    Platform,\n    {\n      variables: {\n        where: { id }\n      },\n      onError: () => {\n        notification['error']({\n          message: 'An error has occurred',\n          description:\n            'This error has been reported to our development team. If this persists please contact our support team.',\n          placement: 'bottomRight'\n        });\n      }\n    }\n  );\n\n  const handleSubmit = async ({\n    name,\n    email,\n    role\n  }: StaffFormData) => {\n    // await updatePlatform({\n    //   variables: {\n    //     where: {\n    //       id,\n    //     },\n    //     data: {\n    //       name: { set: name },\n    //       description: { set: description },\n    //     }\n    //   },\n    // });\n  };\n\n  return (\n    <StaffForm\n      saving={loading}\n      loading={productLoading}\n      data={\n        data\n          ? {\n              email: '',\n              role: 'ADMIN',\n              name: data.platform.name,\n            }\n          : undefined\n      }\n      onClose={onClose}\n      onSubmit={handleSubmit}\n    />\n  );\n};\n","/Users/willgarrod/Projects/signup-web/src/components/form-components/staff/add/add-staff-drawer.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/staff/add/add-staff-form.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/staff/add/existing-staff.tsx",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/staff/mutations/invite-existing-staff.ts",[],"/Users/willgarrod/Projects/signup-web/src/views/app-views/admin-views/settings/staff/router.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/app-views/admin-views/settings/staff/staff-list.tsx",[],"/Users/willgarrod/Projects/signup-web/src/views/app-views/admin-views/schemes/view-scheme.tsx",["3504"],"/Users/willgarrod/Projects/signup-web/src/graphql-src/schemes/queries/scheme.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/index.tsx",[],["3505","3506"],"/Users/willgarrod/Projects/alert-web-2.0/src/serviceWorker.js",[],["3507","3508"],"/Users/willgarrod/Projects/alert-web-2.0/src/App.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/views/router.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/state/index.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/state/theme-model.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/state/store.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/configs/AppConfig.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/hooks/useAuth.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/views/auth-views/authentication/loading/index.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/state/data-model.ts",[],["3509","3510"],"/Users/willgarrod/Projects/alert-web-2.0/src/lang/index.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/state/user-model.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/state/auth-model.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/configs/EnvironmentConfig.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/layouts/auth-layout/index.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/layouts/app-layout/index.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/lang/entries/fr_FR.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/lang/entries/en_US.ts",[],["3511","3512"],"/Users/willgarrod/Projects/alert-web-2.0/src/configs/NavigationConfig.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/graphql-src/auth/mutations/index.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/graphql-src/auth/queries/index.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/constants/ThemeConstant.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/views/app-views/router.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/components/layout-components/navigation/HeaderNav.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/components/layout-components/Footer.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/components/layout-components/navigation/MobileNav.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/components/shared-components/Loading/index.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/utils/index.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/graphql-src/auth/queries/current-user.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/graphql-src/auth/mutations/sign-in.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/graphql-src/auth/queries/verify.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/graphql-src/auth/mutations/verify-user.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/components/layout-components/navigation/Logo.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/components/layout-components/navigation/MenuContent.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/components/layout-components/navigation/NavProfile.tsx",["3513"],"import React from \"react\";\r\nimport { Menu, Dropdown, Avatar, Row } from \"antd\";\r\nimport { \r\n  LogoutOutlined \r\n} from '@ant-design/icons';\r\nimport Icon from 'components/util-components/Icon';\r\nimport { useStoreState } from 'state'\r\nimport useAuth from 'hooks/useAuth'\r\n\r\ninterface MenuItem {\r\n  title: string;\r\n  icon: string;\r\n  path: string;\r\n}\r\n\r\nconst menuItem: MenuItem[] = [\r\n  // {\r\n  //   title: \"Edit Profile\",\r\n  //   icon: EditOutlined ,\r\n  //   path: \"/\"\r\n  //   },\r\n    \r\n  //   {\r\n  //   title: \"Account Setting\",\r\n  //   icon: SettingOutlined,\r\n  //   path: \"/\"\r\n  //   },\r\n  //   {\r\n  //   title: \"Billing\",\r\n  //   icon: ShopOutlined ,\r\n  //   path: \"/\"\r\n  // },\r\n  //   {\r\n  //   title: \"Help Center\",\r\n  //   icon: QuestionCircleOutlined,\r\n  //   path: \"/\"\r\n  // }\r\n]\r\n\r\nexport const NavProfile = () => {\r\n  const name = useStoreState(state => state.user.fullName)\r\n  const email = useStoreState(state => state.user.email)\r\n  const profileImg = useStoreState(state => state.user.picture)\r\n  const { signOut } = useAuth()\r\n\r\n  const profileMenu = (\r\n    <div className=\"nav-profile nav-dropdown\">\r\n      <div className=\"nav-profile-header\">\r\n        <div className=\"d-flex\" style={{ alignItems: 'center' }}>\r\n          <Avatar style={{ backgroundColor: 'rgb(222, 68, 54)', minWidth: 35 }} size={35}>{name.charAt(0)}</Avatar>\r\n          <div className=\"pl-2\">\r\n            <h4 className=\"mb-0\">{name}</h4>\r\n            <span className=\"text-muted\">{email}</span>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <div className=\"nav-profile-body\">\r\n        <Menu>\r\n          {menuItem.map((el, i) => {\r\n            return (\r\n              <Menu.Item key={i}>\r\n                <a href={el.path}>\r\n                  <Row>\r\n                    <Icon className=\"mr-3\" type={el.icon} />\r\n                    <span className=\"font-weight-normal\">{el.title}</span>\r\n                  </Row>\r\n                </a>\r\n              </Menu.Item>\r\n            );\r\n          })}\r\n          <Menu.Item key={menuItem.length + 1} onClick={e => signOut()}>\r\n            <Row>\r\n              <LogoutOutlined className=\"mr-3\"/>\r\n              <span className=\"font-weight-normal\">Sign Out</span>\r\n            </Row>\r\n          </Menu.Item>\r\n        </Menu>\r\n      </div>\r\n    </div>\r\n  );\r\n  return (\r\n    <Dropdown placement=\"bottomRight\" overlay={profileMenu} trigger={[\"click\"]}>\r\n      <Menu className=\"d-flex align-item-center\" mode=\"horizontal\">\r\n        <Menu.Item>\r\n          <Avatar style={{ backgroundColor: 'rgb(222, 68, 54)' }}>{name.charAt(0)}</Avatar>\r\n        </Menu.Item>\r\n      </Menu>\r\n    </Dropdown>\r\n  );\r\n}\r\n\r\nexport default NavProfile;\r\n","/Users/willgarrod/Projects/alert-web-2.0/src/components/shared-components/Flex/index.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/components/util-components/IntlMessage/index.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/components/util-components/Icon/index.js",[],"/Users/willgarrod/Projects/alert-web-2.0/src/components/layout-components/navigation/TopNav.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/components/layout-components/navigation/SideNav.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/views/auth-views/index.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/views/auth-views/authentication/verify/index.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/views/auth-views/errors/error-page-2/index.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/views/auth-views/errors/error-page-1/index.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/views/auth-views/authentication/register-2/index.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/views/auth-views/authentication/forgot-password/index.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/views/auth-views/authentication/register-1/index.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/views/auth-views/authentication/login-2/index.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/views/auth-views/authentication/login-1/index.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/views/auth-views/authentication/login/index.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/views/auth-views/authentication/verify/verify.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/views/auth-views/components/RegisterForm.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/views/auth-views/components/LoginForm.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/assets/svg/icon.js",[],"/Users/willgarrod/Projects/alert-web-2.0/src/components/util-components/CustomIcon/index.tsx",[],"/Users/willgarrod/Projects/alert-web-2.0/src/state/scheme-model.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/graphql-src/users/enums/index.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/graphql-src/users/enums/role.ts",[],"/Users/willgarrod/Projects/alert-web-2.0/src/old-components/incidents/feed/AlertFeedQuery/AlertFeedQuery.jsx",["3514","3515"],"import React, { useState, useEffect } from 'react';\nimport { useQuery, useMutation } from '@apollo/client';\n\nimport { IncidentFeed } from 'graphql-src/incidents/queries';\nimport AlertFeed from '../AlertFeed/AlertFeed';\nimport {\n  AddIncidentToGroup,\n  ApproveIncident,\n  RemoveIncident\n} from 'graphql-src/incidents/mutations';\nimport { AddOffenderToGroup, ApproveOffender } from 'graphql-src/offenders/mutations';\nimport Offline from '../../../global/Offline/Offline';\nimport { useStoreActions, useStoreState } from '../../../../state';\n\nconst AlertFeedQuery = () => {\n  const setBottomNav = useStoreActions(actions => actions.theme.setBottomNav);\n  const setAppBar = useStoreActions(actions => actions.theme.setAppBar);\n  const setTitle = useStoreActions(\n    actions => actions.theme.setTitle\n  );\n  const setStatusBar = useStoreActions(actions => actions.theme.setStatusBar);\n  const setSearch = useStoreActions(actions => actions.theme.setBottomNav);\n  const setSearchText = useStoreActions(actions => actions.theme.setBottomNav);\n  const toggleFetchIncidents = useStoreActions(\n    actions => actions.theme.setBottomNav\n  );\n  const scheme = useStoreState(state => state.scheme.id);\n  const role = useStoreState(state => state.user.role);\n  const userId = useStoreState(state => state.user.id);\n  const search = useStoreState(state => state.theme.search);\n  const fetchIncidents = useStoreState(state => state.theme.fetchIncidents);\n  const admin = role === 'USER' ? true : false;\n\n  const [order, setOrder] = useState('desc')\n  const [allLoaded, setAllLoaded] = useState(false)\n  const [fetching, setFetching] = useState(false)\n  const [networkError, setNetworkError] = useState('')\n  const [crimeTypes, setCrimeTypes] = useState([])\n  const [filterSet, setFilterSet] = useState(false)\n  \n  useEffect(() => {\n    setBottomNav(true);\n    setTitle('Incidents');\n    setAppBar(true);\n    setSearch(true);\n    setSearchText('Search for incidents...');\n    return () => {\n      setSearch(false);\n      setSearchText('');\n      toggleFetchIncidents(true);\n    }\n  }, [])\n\n  useEffect(() => {\n    if (allLoaded)\n      setAllLoaded(false)\n  }, [search])\n\n\n  const changeOrder = order => {\n    setOrder(order)\n    setAllLoaded(false)\n\n  }\n\n  const changeCrimeTypes = crimeTypes => {\n    setCrimeTypes(crimeTypes)\n    setFilterSet(true)\n    setAllLoaded(false)\n  };\n\n  // Set queries based on users role\n  let querySize = 10;\n  if (window.innerWidth > 1239 && window.innerWidth < 1800) {\n    querySize = 12;\n  } else if (window.innerWidth > 1799) {\n    querySize = 16;\n  }\n\n  const variables = {\n    userId,\n    schemeId: scheme,\n    search,\n    order: { createdAt: order },\n    first: querySize,\n    crimeTypes: crimeTypes.length > 0 ? crimeTypes : undefined\n  };\n\n  const { data, loading, fetchMore, refetch, error } = useQuery(IncidentFeed, {\n    variables,\n    fetchPolicy: 'cache-and-network'\n  })\n  const [addIncidentToGroup] = useMutation(AddIncidentToGroup)\n  const [approveIncident] = useMutation(ApproveIncident)\n  const [addOffenderToGroup] = useMutation(AddOffenderToGroup)\n  const [approveOffender] = useMutation(ApproveOffender)\n  const [deleteIncident] = useMutation(RemoveIncident, {\n    update: async (store, { data: { deleteIncident } }) => {\n      const response = store.readQuery({\n        query: IncidentFeed,\n        variables: {\n          cursor,\n          ...variables,\n          first: 1\n        }\n      });\n\n      const data = store.readQuery({\n        query: IncidentFeed,\n        variables\n      });\n      data.incidentFeed = data.incidentFeed.filter(\n        alert => alert.id !== deleteIncident.id\n      );\n      if (response.incidentFeed.length > 0) {\n        data.incidentFeed.push(\n          response.incidentFeed[0]\n        );\n      }\n      store.writeQuery({\n        query: IncidentFeed,\n        data,\n        variables\n      });\n    }\n  })\n\n  let cursor;\n  if (\n    loading &&\n    !!data &&\n    !!data.incidentFeed &&\n    data.incidentFeed.length > 0\n  ) {\n    cursor = data.incidentFeed.slice(-1)[0].id;\n  }\n\n  const loadMore = async () => {\n    if (!allLoaded && !fetching) {\n      // Set fetching state\n      setFetching(true)\n      // Do not fetch more if currently fetching or all records have been fetched\n      await fetchMore({\n          query: IncidentFeed,\n          variables: {\n            cursor,\n            ...variables\n          },\n          updateQuery: (previousResult, { fetchMoreResult }) => {\n            let newAlerts = [];\n            fetchMoreResult.incidentFeed.length === 1 &&\n              fetchMoreResult.incidentFeed[0].id === cursor &&\n              setAllLoaded(true)\n\n            fetchMoreResult.incidentFeed.forEach(alert => {\n              !previousResult.incidentFeed\n                .map(({ id }) => id)\n                .includes(alert.id) && newAlerts.push(alert);\n            });\n\n            return {\n              incidentFeed: [\n                ...previousResult.incidentFeed,\n                ...newAlerts\n              ]\n            };\n          }\n        })\n        .then(() => {\n          setFetching(false)\n        })\n        .catch(error => {\n          setFetching(false)\n          if (error.networkError !== undefined) {\n            setNetworkError(true)\n          }\n        });\n    }\n  };\n\n  const retryLoad = () => {\n    setNetworkError(false)\n    loadMore();\n  };\n\n  return error !== undefined && error.networkError !== undefined ? (\n    <Offline type=\"incidents\" />\n  ) : (\n    <AlertFeed\n      loading={loading}\n      alerts={\n        !!data\n          ? data.incidentFeed\n          : []\n      }\n      refetch={refetch}\n      setOrder={changeOrder}\n      search={search}\n      loadMore={loadMore}\n      addIncidentToGroup={addIncidentToGroup}\n      approveIncident={approveIncident}\n      setStatusBar={setStatusBar}\n      addOffenderToGroup={addOffenderToGroup}\n      approveOffender={approveOffender}\n      deleteIncident={deleteIncident}\n      admin={admin}\n      userId={userId}\n      loadingMore={fetching}\n      networkError={networkError}\n      retryLoad={retryLoad}\n      fetchIncidents={fetchIncidents}\n      toggleFetchIncidents={\n        toggleFetchIncidents\n      }\n      order={order}\n      crimeTypes={crimeTypes}\n      setCrimeTypes={changeCrimeTypes}\n      filterSet={filterSet}\n    />\n  )\n}\n\nexport default AlertFeedQuery;\n","/Users/