od/Projects/signup-web/src/components/form-components/platforms/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/platforms/edit/edit-platform-form.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/platforms/platform-form.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/platforms/add/add-platform-drawer.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/platforms/edit/edit-platform-drawer.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/platforms/add/add-platform-form.tsx",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/platforms/mutations/index.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/platforms/mutations/update-platform.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/platforms/mutations/create-platform.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/devices/queries/manufacturers.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/items/queries/item.ts",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/devices/queries/device.ts",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/form/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/form/standard-form.tsx",["2965"],"import React, { useRef, useEffect } from \"react\";\nimport {\n  Form,\n  Button,\n  FormInstance,\n  Row,\n  FormItemProps,\n  Checkbox\n} from \"antd\";\nimport { Grow } from \"components/layout-components\";\n\ninterface Field extends FormItemProps {\n  render(props: { disabled: boolean; }): JSX.Element;\n  checkbox?: boolean;\n}\n\ninterface Props<T> {\n  onClose(): void;\n  onSubmit(data: T): void;\n  loading?: boolean;\n  saving: boolean;\n  data?: T;\n  initialValues: T;\n  fields: Field[]\n}\n\nexport const StandardForm = <T,>({\n  onClose,\n  onSubmit,\n  loading,\n  saving,\n  data,\n  initialValues,\n  fields\n}: Props<T>) => {\n  const formRef = useRef<FormInstance<T>>(null);\n\n  const tailLayout = {\n    wrapperCol: { span: 22 },\n  };\n\n  useEffect(() => {\n    if (data) {\n      // @ts-expect-error type does not like other type\n      formRef.current?.setFieldsValue(data);\n    }\n  }, [data]);\n\n  const handleClose = () => {\n    formRef.current?.resetFields();\n    onClose();\n  };\n\n  const handleSubmit = async (data: T) => {\n    onSubmit(data);\n  };\n\n  return (\n    <Form\n      name=\"basic\"\n      onFinish={handleSubmit}\n      onFinishFailed={() => {}}\n      ref={formRef}\n      style={{ display: \"flex\", flexDirection: \"column\", flex: 1 }}\n      initialValues={initialValues}\n      layout=\"vertical\"\n    >\n      {fields.map(({ render, name, label, rules, checkbox }) => (\n        <Form.Item\n          label={label}\n          name={name}\n          rules={rules}\n          valuePropName={checkbox ? 'checked' : undefined}\n        >\n          {render({ disabled: loading || saving })}\n        </Form.Item>\n      ))}\n\n      <Grow />\n\n      <Form.Item {...tailLayout}>\n        <Row justify=\"end\">\n          <Button\n            type=\"ghost\"\n            onClick={handleClose}\n            style={{ marginRight: 15 }}\n            disabled={loading || saving}\n          >\n            Cancel\n          </Button>\n          <Button\n            type=\"primary\"\n            htmlType=\"submit\"\n            loading={saving}\n            disabled={loading}\n          >\n            Submit\n          </Button>\n        </Row>\n      </Form.Item>\n    </Form>\n  );\n};\n","/Users/willgarrod/Projects/signup-web/src/components/form-components/items/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/items/edit/edit-item-drawer.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/items/item-form.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/items/add/add-item-drawer.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/items/add/add-item-form.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/items/edit/edit-item-form.tsx",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/items/mutations/index.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/items/mutations/create-item.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/items/mutations/update-item.ts",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/devices/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/devices/device-form.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/devices/edit/edit-device-drawer.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/devices/add/add-device-form.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/devices/edit/edit-device-form.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/devices/add/add-device-drawer.tsx",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/devices/mutations/index.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/devices/mutations/create-device.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/devices/mutations/update-device.ts",[],"/Users/willgarrod/Projects/signup-web/src/graphql-src/staff/queries/existing-staff.ts",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/staff/index.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/staff/staff-form.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/staff/edit/edit-staff-drawer.tsx",[],"/Users/willgarrod/Projects/signup-web/src/components/form-components/staff/edit/edit-staff-form.tsx",["2966"],"import React from \"react\";\nimport { useMutation, MutationUpdaterFn, useQuery } from \"@apollo/client\";\nimport { notification } from \"antd\";\nimport {\n  UpdatePlatform,\n  UpdatePlatformArg,\n  UpdatePlatformRes,\n} from \"graphql-src/platforms/mutations\";\nimport { Platform, PlatformRes, PlatformArgs } from \"graphql-src/platforms/queries\";\nimport { StaffForm, StaffFormData } from \"../staff-form\";\n\ninterface Props {\n  onClose(): void;\n  update?: MutationUpdaterFn<UpdatePlatformRes>;\n  onSuccess?(): void;\n  onError?(): void;\n  id: string;\n}\n\nexport const EditPlatformForm = ({\n  onClose,\n  update,\n  onError,\n  onSuccess,\n  id,\n}: Props) => {\n  const [updatePlatform, { loading }] = useMutation<\n    UpdatePlatformRes,\n    UpdatePlatformArg\n  >(UpdatePlatform, {\n    update,\n    onCompleted: onSuccess,\n    onError,\n  });\n\n  const { data, loading: productLoading } = useQuery<PlatformRes, PlatformArgs>(\n    Platform,\n    {\n      variables: {\n        where: { id }\n      },\n      onError: () => {\n        notification['error']({\n          message: 'An error has occurred',\n          description:\n            'This error has been reported to our development team. If this persists please contact our support team.',\n          placement: 'bottomRight'\n        });\n      }\n    }\n  );\n\n  const handleSubmit = async ({\n    name,\n    email,\n    role\n  }: StaffFormData) => {\n    // await updatePlatform({\n    //   variables: {\n    //     where: {\n    //       id,\n    //     },\n    //     data: {\n    //       name: { set: name },\n    //       description: { set: description },\n    //     }\n    //   },\n    // });\n  };\n\n  return (\n    <StaffForm\n      saving={loading}\n      loading={productLoading}\n      data={\n        data\n          ? {\n              email: '',\n              role: 'ADMIN',\n              name: data.platform.name,\n            }\n          : undefined\n      }\n      onClose={onClose}\n      onSubmit={handleSubmit}\n    />\n  );\n};\n","/Users/