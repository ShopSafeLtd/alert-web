{
  "name": "alert-web",
  "version": "0.1.0",
  "main": "./src/index.tsx",
  "scripts": {
    "prepare": "husky install",
    "start": "vite",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' && tsc && vite build ",
    "serve": "vite preview",
    "dev": "concurrently \"vite\" \"gulp watch\"",
    "postinstall": "node ./postInstall.js",
    "extract": "formatjs extract 'src/**/*.ts*' --ignore='**/*.d.ts' --out-file en/lang.json",
    "compile": "formatjs compile",
    "extract-compile": "formatjs extract 'src/**/*.ts*' --ignore='**/*.d.ts' --out-file temp.json --flatten --id-interpolation-pattern '[sha512:contenthash:base64:6]' && formatjs compile 'temp.json' --out-file en/lang.json && rm temp.json",
    "upload-i18n": "formatjs extract 'src/**/*.ts*' --ignore='**/*.d.ts' --out-file en/lang.json && simplelocalize upload --apiKey e79c3F36e902c75AD5dDdddc9c4FaCF48804d6fd8Dc25Ba5  --uploadPath en/lang.json --uploadFormat simplelocalize-json --languageKey en_US",
    "download-i18n": "simplelocalize download --apiKey e79c3F36e902c75AD5dDdddc9c4FaCF48804d6fd8Dc25Ba5  --downloadPath ./src/lang/locales/{lang}.json  --downloadFormat single-language-json",
    "e": "npx eslint .",
    "validate-build": "NODE_OPTIONS='--max-old-space-size=8192' && tsc --noEmit && vite build",
    "clean:graphql": "find ./src -type f -path '*/graphql/*' \\( -name '*.generated.ts' -o -name '*.generated.tsx' \\) -exec rm -f {} + && graphql-codegen --config codegen.yml",
    "generate": "graphql-codegen --config codegen.yml"
  },
